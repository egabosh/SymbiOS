# Docker update - pull and restart all Docker Compose services

# Remove notify.sh directory if created as a directory by Docker volume
if [ -d /usr/local/bin/notify.sh ]
then
  rmdir /usr/local/bin/notify.sh
fi

g_echo_ok "check for updates"

# A backup run keeps a transfer open for hours; recreating a container in the
# middle of it aborts the upload, and the image pulls and rebuilds would
# compete with the backup for the same disks. Defer the whole Docker update
# to the next run while a backup is running - that is either this host's own
# backup (lock file) or a backup INTO this host (the client refreshes the
# restic lock inside its repository every few minutes).
g_backup_pid="$(cat /var/lock/backup.sh.lock 2>/dev/null)"
if [[ -n "$g_backup_pid" ]] && [[ -d "/proc/$g_backup_pid" ]]
then
  g_echo_note "A backup is running on this host - deferring the Docker update to the next run"
  return 0
fi
# Only the known repository layout is probed: a search over the whole media
# volume takes almost a minute, the repositories live at <media_root>/[<dir>/]<repo>.
g_media_root="$(f_symbios_var media_root "${g_data_root}/media")"
if [[ -n "$(find "$g_media_root"/*/locks "$g_media_root"/*/*/locks \
    -maxdepth 1 -type f -newermt "-15 minutes" -print -quit 2>/dev/null)" ]]
then
  g_echo_note "A backup into this host is running - deferring the Docker update to the next run"
  return 0
fi

# Clean up Docker images
docker system prune -af

# Find all Docker compose directories excluding special ones
find "${g_base_services_root}" "${g_services_root}" -maxdepth 1 -mindepth 1 -type d | grep -E -v "mailcow-dockerized$|.del$|.bak$|.old$|var-lib-docker$|var-lib-containerd$" | while read g_docker_dir
do
  # Skip directories without a compose file
  if [ ! -f "$g_docker_dir/docker-compose.yml" ]
  then
    continue
  fi
  g_echo_ok "$g_docker_dir"
  cd "${g_docker_dir}"
  if docker -l warn compose --ansi never pull --include-deps 2>&1 | grep " Pulled"
  then
    # Write PID file for this service
    echo $$ >/run/$(basename $g_docker_dir)
    if ! docker -l warn compose --ansi never up -d --remove-orphans >$g_tmp/up 2>&1
    then
      g_echo_error "$g_docker_dir: docker compose up failed: $(cat $g_tmp/up)"
    fi
    # Check for started containers
    if grep -E -v -- "-wpcli" $g_tmp/up | grep "Started" >${g_tmp}/started
    then
      g_echo_warn "$g_docker_dir Update installed: $(cat ${g_tmp}/started)"
    fi
  fi
  if [ -f Dockerfile ]
  then
    if docker -l warn compose --ansi never build --progress=plain --pull --no-cache --force-rm >$g_tmp/build 2>&1
    then
      if ! docker -l warn compose --ansi never up -d --force-recreate --remove-orphans >$g_tmp/up 2>&1
      then
        g_echo_error "$g_docker_dir: docker compose up failed: $(cat $g_tmp/up)"
      fi
    else
      g_echo_error "$g_docker_dir: docker compose build failed: $(cat $g_tmp/build)"
    fi
  fi
done
