# Docker update - pull and restart all Docker Compose services

# Remove notify.sh directory if created as a directory by Docker volume
if [ -d /usr/local/bin/notify.sh ]
then
  rmdir /usr/local/bin/notify.sh
fi

g_echo_ok "check for updates"

# Only the receiving side of a backup has to stand still: the client holds one
# SFTP transfer open for hours and recreating the receiving SFTP server aborts
# the upload. Every other service - and the whole sending host - updates
# normally, because no long-lived connection depends on them.
# A backup INTO this host is detected through its restic lock, which the client
# refreshes every few minutes. Only the known repository layout is probed: a
# search over the whole media volume takes almost a minute, the repositories
# live at <media_root>/[<dir>/]<repo>.
g_backup_incoming=0
g_media_root="$(f_symbios_var media_root "${g_data_root}/media")"
if [[ -n "$(find "$g_media_root"/*/locks "$g_media_root"/*/*/locks \
    -maxdepth 1 -type f -newermt "-15 minutes" -print -quit 2>/dev/null)" ]]
then
  g_backup_incoming=1
  g_echo_note "A backup into this host is running - skipping the SFTP server for this run"
fi

# Clean up Docker images
docker system prune -af

# Find all Docker compose directories. Skip backup markers, special stacks and
# legacy host-named dirs (<service>.<domain>.<tld>): they have no live compose
# project, so `docker compose up` there fails every night with an external
# network error while the real service keeps running under its plain name.
find "${g_base_services_root}" "${g_services_root}" -maxdepth 1 -mindepth 1 -type d | grep -E -v "(^|/)(mailcow-dockerized|var-lib-docker|var-lib-containerd)$|\.(del|bak|old)$|/[^/]*\.[^/]*\.[^/]*$" | while read g_docker_dir
do
  # Skip directories without a compose file
  if [ ! -f "$g_docker_dir/docker-compose.yml" ]
  then
    continue
  fi
  # Never recreate the SFTP server while a backup is being written into it
  if [[ "$g_backup_incoming" == 1 ]] && [[ "$(basename "$g_docker_dir")" == "sftp-share" ]]
  then
    g_echo_note "$g_docker_dir: skipped - a backup into this host is running"
    continue
  fi
  g_echo_ok "$g_docker_dir"
  cd "${g_docker_dir}"
  if docker -l warn compose --ansi never pull --include-deps 2>&1 | grep " Pulled"
  then
    # Write PID file for this service
    echo $$ >/run/$(basename $g_docker_dir)
    if ! docker -l warn compose --ansi never up -d --remove-orphans >$g_tmp/up 2>&1
    then
      g_echo_error "$g_docker_dir: docker compose up failed: $(cat $g_tmp/up)"
    fi
    # Check for started containers
    if grep -E -v -- "-wpcli" $g_tmp/up | grep "Started" >${g_tmp}/started
    then
      g_echo_warn "$g_docker_dir Update installed: $(cat ${g_tmp}/started)"
    fi
  fi
  if [ -f Dockerfile ]
  then
    if docker -l warn compose --ansi never build --progress=plain --pull --no-cache --force-rm >$g_tmp/build 2>&1
    then
      if ! docker -l warn compose --ansi never up -d --force-recreate --remove-orphans >$g_tmp/up 2>&1
      then
        g_echo_error "$g_docker_dir: docker compose up failed: $(cat $g_tmp/up)"
      fi
    else
      g_echo_error "$g_docker_dir: docker compose build failed: $(cat $g_tmp/build)"
    fi
  fi
done
