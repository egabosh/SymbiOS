# Debian system update - check for and install security/feature updates
g_echo_ok "Checking for systemupdates"
export DEBIAN_FRONTEND=noninteractive

# Refresh package lists quietly: full apt output is only interesting when it fails
if ! apt-get -yy update --allow-releaseinfo-change >$g_tmp/apt-update 2>&1
then
  g_echo_error "apt-get update failed: $(tail -n 5 $g_tmp/apt-update)"
fi
if ! hostname | grep -q ".mint."
then

  if ! grep -q "non-free-firmware" /etc/apt/sources.list 2>/dev/null && ! grep -rq "non-free-firmware" /etc/apt/sources.list.d/ 2>/dev/null
  then
    g_echo_warn "Allowing non-free-firmware"
    sed -i 's/ non-free / non-free non-free-firmware /g; s/ non-free$/ non-free non-free-firmware/' /etc/apt/sources.list
    for g_src in /etc/apt/sources.list.d/*
    do
      [ -f "$g_src" ] && sed -i 's/ non-free / non-free non-free-firmware /g; s/ non-free$/ non-free non-free-firmware/' "$g_src"
    done
  fi

  # Simulate the dist-upgrade and store it shell-quoted in sys-updatelist
  # (the quoting keeps $(cat ...) safe when it is echoed back later).
  # Nothing is printed here - the summary is only shown when updates exist.
  apt-get -s dist-upgrade 2>&1 | sed -e "s/'/'\\\\''/g; 1s/^/'/; \$s/\$/'/" > $g_tmp/sys-updatelist
  if ! egrep -q "^0.+, 0 .+, 0 .+ 0 .+\." $g_tmp/sys-updatelist
  then
    g_echo_warn "Systemupdate will be installed: $(cat $g_tmp/sys-updatelist)"
    apt-get -yy dist-upgrade | sed -e "s/'/'\\\\''/g; 1s/^/'/; \$s/\$/'/" | tee $g_tmp/sys-update || g_echo_error "apt-get -yy dist-upgrade failed $($g_tmp/sys-update)"
    needrestart -b -r a | egrep -q "^NEEDRESTART-KSTA: [2|3]" && g_echo_warn "System reboot needed"
    g_echo_warn $(apt-get -yy --purge autoremove 2>&1 | egrep -A10 "^The following packages will be REMOVED:")
    apt-get -yy autoclean
    g_echo_warn $(find /etc -name '.dpkg-' -o -name '.ucf-' -o -name '*.merge-error')
    apt-get purge '~o'
  fi

  # 2>/dev/null: /etc/apt/sources.list does not exist on deb822 (trixie) systems
  if grep -qr bookworm /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null
  then
    g_echo_warn "Distributionupdate from bookworm to trixie will be installed!!!"
    rm -f /etc/apt/sources.list.d/deb_debian_org_debian.list
    sed -i 's/bookworm/trixie/g' /etc/apt/sources.list
    sed -i 's/bookworm/trixie/g' /etc/apt/sources.list.d/*
    apt-get -yy update --allow-releaseinfo-change
    apt-get -yy -o "Dpkg::Options::=--force-confold" upgrade --without-new-pkgs
    apt-get -yy -o "Dpkg::Options::=--force-confold" full-upgrade
    apt-get -yy -o "Dpkg::Options::=--force-overwrite" --fix-broken install
    apt-get -yy autoremove
  fi

fi

# Update flatpak apps, but suppress the pointless "Nothing to do." output
if [ -x /usr/bin/flatpak ]
then
  g_flatpak_out="$(flatpak update --system --noninteractive --force-remove 2>&1 | grep -v "^$" | grep -v "^Nothing to do\.$")"
  [[ -n "${g_flatpak_out}" ]] && g_echo_note "${g_flatpak_out}"
fi

# run all defined playbooks if available
if ! [[ $1 = "noplaybooks" ]]
then
  [[ -s "/usr/local/etc/playbooks" ]] && bash /usr/local/sbin/linux_setups_debian_install.sh
fi

# clean apt cache
apt-get -yy clean

# clean root mails
g_mail_count=$(mail -H | wc -l)
g_mail_delete=$((g_mail_count-100))
if [ "$g_mail_delete" -gt 0 ]
then
  printf "d 1-%d\nq\n" "$g_mail_delete" | mail
fi
