# Autoupdate module: monthly SMART short self-test on all physical disks.
#
# Starts a short self-test (`smartctl -t short`) on every SMART-capable block
# device on the 1st of each month. The result lands in the drive self-test log
# and is evaluated by the disks.check selftest-failure trend, so the health
# checks always report a *fresh* media-read result instead of stale ones.
#
# Forcing: SMART_SELFTEST_NOW=1 autoupdate.sh smart-selftest

if [[ "${SMART_SELFTEST_NOW:-0}" != "1" && "$(date -u +%d)" != "01" ]]
then
  return 0
fi

command -v smartctl >/dev/null 2>&1 || return 0

g_selflog="${g_log_dir}/smart-selftest.log"
[[ -z "${g_log_dir:-}" ]] && g_selflog="/var/log/smart-selftest.log"

for g_name in $(ls /sys/block | sort)
do
  case "$g_name" in
    loop*|ram*|dm-*|md*|zram*|sr*|scd*|nbd*|rbd*)
      continue
      ;;
  esac
  g_dev="/dev/${g_name}"
  [[ -e "$g_dev" ]] || continue

  # USB bridges need forced SCSI/ATA translation; NVMe and direct disks do not
  g_opt=""
  if [[ "$g_name" != nvme* && "$g_name" != mmcblk* ]]
  then
    if readlink -f "/sys/block/${g_name}" | grep -q "/usb"
    then
      g_opt="-d sat"
    fi
  fi

  if smartctl $g_opt -t short "$g_dev" >"$g_selflog.tmp" 2>&1
  then
    g_echo "SMART short self-test started on $g_dev"
  else
    # Unsupported devices (SD cards, virtio/QEMU, empty readers) are expected
    g_echo_note "SMART short self-test not possible on $g_dev"
  fi
done
rm -f "$g_selflog.tmp" 2>/dev/null

return 0