# Check: Detect failed Ansible playbook runs in log files
f_check_cache "symbios-healthcheck-playbooks" || return 2>/dev/null || true

g_playbook_failures=$(grep -l 'failed=1\|FAILED' "${g_log_dir}/playbook-*.log" 2>/dev/null)
if [[ -n "$g_playbook_failures" ]]
then
  for g_logfile in $g_playbook_failures
  do
    g_playbook_name=$(basename "$g_logfile" | sed 's/^playbook-//; s/\.log$//')
    g_echo_error "Playbook failed: $g_playbook_name ($g_logfile)"
  done
fi
