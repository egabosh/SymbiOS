CHECK_CATEGORY="services"
CHECK_TITLE="External Targets"
CHECK_DESC="Checks if configured external systems are reachable via SSH."
CHECK_DETAIL="Reads host: entries from external-systems.yml and tests TCP port 22.|Without a configuration file there is nothing to check (status ok)."

# IMPORTANT: This file is SOURCED by runchecks.sh. Never call exit here -
# an exit would terminate the whole health daemon mid-loop.

# Cooldown: each host probe costs up to 2s
f_check_cache "symbios-healthcheck-external-targets" || return 2>/dev/null || true

g_external_config="${g_config_dir}/external-systems.yml"

# No config file: healthy no-op
if [[ ! -f "$g_external_config" ]]
then
  g_echo_note "no external systems configured (${g_external_config} missing)"
  return 2>/dev/null || true
fi

# Count systems and check connectivity (TCP port 22, 2s timeout per host)
g_total=0
g_reachable=0
g_unreachable=0
while IFS= read -r g_line
do
  if [[ "$g_line" =~ host:\ (.+) ]]
  then
    g_host="${BASH_REMATCH[1]}"
    g_host="${g_host//\"/}"
    g_host="${g_host//\'}"
    g_total=$((g_total + 1))
    if timeout 2 bash -c "echo >/dev/tcp/${g_host}/22" 2>/dev/null
    then
      g_reachable=$((g_reachable + 1))
    else
      g_unreachable=$((g_unreachable + 1))
    fi
  fi
done < "$g_external_config"

# Report result via gaboshlib (g_echo_error marks the check as failed)
if [[ "$g_total" -eq 0 ]]
then
  g_echo_note "no external systems configured"
elif [[ "$g_unreachable" -gt 0 ]]
then
  g_echo_error "${g_unreachable} of ${g_total} external systems unreachable"
else
  g_echo_note "${g_reachable}/${g_total} external systems reachable"
fi
