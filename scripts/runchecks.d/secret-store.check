CHECK_CATEGORY="system"
CHECK_TITLE="Central Secret Store"
CHECK_DESC="Checks the encrypted secret store and its references from inventory."
CHECK_DETAIL="Verifies identity and directory permissions, resolves every secret: reference in inventory, and reports leftover transient plaintext files.|Warns about known credential keys that are still stored as plaintext rather than a secret: reference.|Never prints a secret value."

# The store is a baseline component, but a pre-mount tick can see an empty
# data root. Stay quiet until the identity exists so a boot does not alert.
[[ -r "${g_data_root}/.keys/symbios-secret.age.key" ]] || return 0

g_secret_identity="${g_data_root}/.keys/symbios-secret.age.key"
g_secret_dir="${g_config_dir}/secrets"

if [[ "$(stat -c %a "${g_secret_identity}" 2>/dev/null)" != "600" ]]
then
  g_echo_error "age identity must be mode 0600: ${g_secret_identity}"
fi

if [[ ! -d "${g_secret_dir}" || "$(stat -c %a "${g_secret_dir}" 2>/dev/null)" != "700" ]]
then
  g_echo_error "secret directory must be mode 0700: ${g_secret_dir}"
fi

# Every ciphertext is 0600. Group-readable copies would defeat the store.
while read -r g_bad_mode
do
  [[ -n "${g_bad_mode}" ]] || continue
  g_echo_error "secret ciphertext has unsafe permissions: ${g_bad_mode}"
done < <(find "${g_secret_dir}" -type f -name '*.age' -perm /077 -print 2>/dev/null)

# A reference without a ciphertext would silently blank the credential when
# the playbook resolves it. Report the name only, never the value.
while read -r g_ref
do
  [[ -n "${g_ref}" ]] || continue
  [[ -f "${g_secret_dir}/${g_ref}.age" ]] \
    || g_echo_error "secret reference has no ciphertext: ${g_ref}"
done < <(grep -oE 'secret:[A-Za-z0-9][A-Za-z0-9._/-]*' "${g_inventory}" 2>/dev/null | sed 's/^secret://' | sort -u)

# Leftovers from a crashed get/put are plaintext. One hour grace covers a
# playbook that is still running; anything older is a real leak.
while read -r g_stale
do
  [[ -n "${g_stale}" ]] || continue
  g_echo_error "stale transient secret file: ${g_stale}"
done < <(find "${g_config_dir}" -maxdepth 1 -type f \
  \( -name '.secret-*' -o -name '.input-*' -o -name '.value-*' \) \
  -mmin +60 -print 2>/dev/null)

# Migration is staged, so plaintext keys are a warning, not a failure.
for g_key in ddns_apikey smtp_password matrix_password matrix_token ai_apikey \
  ai_stt_key ai_tts_key ap_passphrase router_upnp_password
do
  g_value="$(grep -E "^[[:space:]]*${g_key}:[[:space:]]*" "${g_inventory}" 2>/dev/null \
    | head -1 | cut -d: -f2- | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^"//; s/"$//; s/^'"'"'//; s/'"'"'$//')"
  [[ -n "${g_value}" && "${g_value}" != secret:* ]] \
    && g_echo_warn "credential still in plaintext inventory: ${g_key}"
done
