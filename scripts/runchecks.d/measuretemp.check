CHECK_CATEGORY="system"
CHECK_TITLE="CPU Temperature (RPi)"
CHECK_DESC="Checks CPU temperature on Raspberry Pi (above 65C)."
CHECK_DETAIL="Uses vcgencmd measure_temp to read the CPU temperature.|Only runs on Raspberry Pi (vcgencmd must be installed).|Warns when temperature exceeds 65 degrees Celsius.|High temperature may cause thermal throttling."

# Check CPU temperature via vcgencmd on Raspberry Pi
if which vcgencmd >/dev/null 2>&1
then
  g_temp=$(vcgencmd measure_temp | grep ^temp= | cut -d"=" -f2 | cut -d. -f1)
  if [[ $g_temp -gt 65 ]]
  then
    g_echo_error "Server temperature high $g_temp°C"
  fi
fi
