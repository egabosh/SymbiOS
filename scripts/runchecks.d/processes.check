CHECK_CATEGORY="system"
CHECK_TITLE="Stuck Processes"
CHECK_DESC="Detects processes stuck for more than 30 minutes."
CHECK_DETAIL="Monitors processes in D (uninterruptible sleep),|Z (zombie), or R (running) state.|Tracks each PID over time in a temp directory.|Alerts if a process stays stuck for more than 30 minutes.|Excludes known long-running operations (USB storage, RAID, btrfs balance/replace/scrub)."

# Monitor processes in D (uninterruptible), Z (zombie) or R (running) state
mkdir -p ${g_tmp}/proc-check
# Clean up processes that are no longer in a monitored state
ls ${g_tmp}/proc-check | while read g_odzpid
do
  if ! grep -E -q "^State:.+D \(|State:.+Z \(|State:.+R \(" /proc/$g_odzpid/status 2>/dev/null
  then
    rm ${g_tmp}/proc-check/$g_odzpid
  fi
done
# Report processes stuck in monitored state for more than 30 minutes
# Process substitution keeps the loop in the current shell, so the error flag
# set by g_echo_error is visible to runchecks.sh (a plain pipeline would lose it)
while read g_dzpid
do
  if [[ -f ${g_tmp}/proc-check/$g_dzpid ]]
  then
    g_timestamp=$(ls --full-time ${g_tmp}/proc-check/$g_dzpid | sed 's/  */ /g' | cut -d" " -f6,7)
    date >>${g_tmp}/proc-check/$g_dzpid
    touch -d "$g_timestamp" ${g_tmp}/proc-check/$g_dzpid
    if find ${g_tmp}/proc-check/$g_dzpid -mmin +30 | grep -q $g_dzpid
    then
      ps aufx | grep $g_dzpid | grep -v grep >${g_tmp}/proc-check-$g_dzpid.notify
      pstree $g_dzpid >>${g_tmp}/proc-check-$g_dzpid.notify
      cat ${g_tmp}/proc-check/$g_dzpid >>${g_tmp}/proc-check-$g_dzpid.notify
      # Known long-running operations legitimately sit in D state for hours:
      # USB storage I/O, mdadm resync kernel threads, and btrfs
      # balance/replace/scrub (a dev-replace rebuilds the whole mirror of a
      # pulled disk - waiting on it is the process doing its job).
      grep -E -q "usb-storage|md[0-9]*_|btrfs (balance|replace|scrub)" ${g_tmp}/proc-check-$g_dzpid.notify || g_echo_error "$(cat ${g_tmp}/proc-check-$g_dzpid.notify)"
    fi
  else
    date >${g_tmp}/proc-check/$g_dzpid
  fi
done < <(grep -E "^State:.+D \(|State:.+Z \(|State:.+R \(" /proc/[0-9]*/status | cut -d/ -f3)
