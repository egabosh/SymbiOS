CHECK_CATEGORY="system"
CHECK_TITLE="Disk Usage"
CHECK_DESC="Monitors disk space on key partitions (root, config, home)."
CHECK_DETAIL="Checks /, /config, and optionally /home mount points.|Warns above 75% usage (warning), critical above 90%.|Full disks can crash services and prevent log writing.|This is separate from the basic df check (stricter thresholds)."

# Check: Monitor disk usage on key mount points and warn on high usage
f_check_cache "symbios-healthcheck-disk" || return 2>/dev/null || true

g_df_targets="/ /config"
[[ -d "/home" ]] && mountpoint -q /home 2>/dev/null && g_df_targets="/ /config /home"

df $g_df_targets | tail -n +2 | while read g_line
do
  g_mount=$(echo "$g_line" | awk '{print $6}')
  g_pct=$(echo "$g_line" | awk '{print $5}' | tr -d '%')
  if [[ "$g_pct" -gt 90 ]]
  then
    g_echo_error "Disk ${g_mount} critically full: ${g_pct}%"
  elif [[ "$g_pct" -gt 75 ]]
  then
    g_echo_error "Disk ${g_mount} usage high: ${g_pct}%"
  fi
done
