CHECK_CATEGORY="system"
CHECK_TITLE="Reboot Required"
CHECK_DESC="Reports a pending system reboot, e.g. after a kernel update."
CHECK_DETAIL="Reads the Debian reboot marker /run/reboot-required and its package list.|Compares the running kernel (uname -r) with the installed kernel image packages.|This check only reports; a reboot comes from the opt-in uptime policy or an explicit WebUI action."

# Shared detection from symbios-lib.sh: apt marker plus kernel comparison,
# because trixie may not write the marker after a kernel update. This check
# only reports; reboot-threshold.update uses the same function when the
# opt-in uptime policy is enabled.
if f_reboot_needed
then
  g_echo_error "${g_reboot_reason}"
fi
