CHECK_CATEGORY="system"
CHECK_TITLE="CIS Benchmark Audit"
CHECK_DESC="Read-only CIS Debian 13 Level 1 audit of the curated SymbiOS control subset."
CHECK_DETAIL="Runs daily from cron and caches a JSON report in <log>/cis-audit.json.|Shows a warning for every control that fails and is not documented as an accepted deviation.|Accepted deviations are listed with their reasons in SECURITY.md under 'CIS Benchmark Scope and Deviations'.|An error means the cached report is unreadable; run 'symbios-cis-audit.sh run' on the host to regenerate it."

# The report is generated by the optional cis-audit playbook. Hosts without
# that playbook have nothing to report and must not show a permanent warning.
f_check_cache "cis-audit" || return 2> /dev/null || true

g_cis_report="${g_log_dir}/cis-audit.json"
[[ -r "$g_cis_report" ]] || return 0

if ! jq -e . "$g_cis_report" > /dev/null 2>&1
then
  g_echo_error "CIS audit report is unreadable - run symbios-cis-audit.sh run."
  return 0
fi

g_cis_failed="$(jq -r '.summary.failed // 0' "$g_cis_report")"
g_cis_waived="$(jq -r '.summary.waived // 0' "$g_cis_report")"
g_cis_undoc="$(jq -r '.summary.undocumented // 0' "$g_cis_report")"
g_cis_timestamp="$(jq -r '.timestamp // ""' "$g_cis_report")"
g_cis_age_hours=0
if [[ -n "$g_cis_timestamp" ]]
then
  g_cis_age_hours=$(( ($(date +%s) - $(date -d "$g_cis_timestamp" +%s 2> /dev/null || echo 0)) / 3600 ))
fi

if [[ "$g_cis_age_hours" -ge 48 ]]
then
  g_echo_warn "CIS audit is ${g_cis_age_hours} hours old - run symbios-cis-audit.sh run."
fi

if [[ "$g_cis_undoc" -gt 0 ]]
then
  g_echo_warn "${g_cis_undoc} CIS waiver(s) are missing from SECURITY.md - add the documented reason."
fi

if [[ "$g_cis_failed" -gt 0 ]]
then
  g_cis_ids="$(jq -r '.checks[] | select(.status == "fail") | .id' "$g_cis_report" | head -5 | paste -sd, -)"
  g_echo_warn "${g_cis_failed} CIS control(s) deviate: ${g_cis_ids} - see SECURITY.md for accepted deviations."
fi
