CHECK_CATEGORY="services"
CHECK_TITLE="OpenVPN Client"
CHECK_DESC="Checks that all enabled OpenVPN client tunnels are up."
CHECK_DETAIL="Verifies openvpn@<name>.service is active and the tunnel interface carries an IP.|Feeds e.g. Home Assistant IoT devices (Shelly) through the tunnel.|If down, all devices behind the tunnel are silent."

# Healthcheck for OpenVPN client tunnels (enabled flag in inventory).
f_check_cache "symbios-healthcheck-openvpn" || return 2>/dev/null || true

# Read openvpn_clients from the inventory and verify each enabled tunnel is
# active and its interface carries an IP. An empty dict means the feature is
# unused. jq keeps Python's truthiness rules for the enabled flag.
f_rows="$(f_symbios_var_json openvpn_clients \
  | jq -r 'def truthy:
             if . == false or . == null or . == 0 or . == "" or
                . == [] or . == {} then false else true end;
           to_entries[]
           | select((.value | type) == "object")
           | select(.value.enabled | truthy)
           | [.key, (.value.interface // "" | tostring)] | @tsv' \
  2>/dev/null || true)"
f_bad=""
while IFS=$'\t' read -r f_name f_iface
do
  [[ -n "${f_name}" ]] || continue
  if ! systemctl is-active "openvpn@${f_name}" >/dev/null 2>&1
  then
    f_bad="${f_bad}${f_bad:+$'\n'}${f_name} (service down)"
    continue
  fi
  if [[ -n "${f_iface}" && "${f_iface}" != "tun" && \
        "${f_iface}" != "tap" && "${f_iface}" != "null" ]]
  then
    f_out="$(ip -o -4 addr show dev "${f_iface}" 2>/dev/null || true)"
    [[ "${f_out}" == *"inet "* ]] || \
      f_bad="${f_bad}${f_bad:+$'\n'}${f_name} (no IP on ${f_iface})"
  fi
done <<< "${f_rows}"
if [[ -n "${f_bad}" ]]
then
  g_echo_error "OpenVPN tunnels down: ${f_bad}"
fi
