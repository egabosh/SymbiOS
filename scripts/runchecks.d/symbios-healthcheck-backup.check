CHECK_CATEGORY="services"
CHECK_TITLE="Backup"
CHECK_DESC="Checks that backups exist, are recent and not stored locally only."
CHECK_DETAIL="Watches the success marker written by the nightly backup job.|Daily snapshots protect all data below /symbios (services, databases, configuration).|If this fails, no recent backup exists - check Settings -> Backup.|Warns when no backup exists at all or the newest one is older than 7 days (limit configurable via backup_max_age_days in the inventory).|Also warns while only local snapshots exist: they share the fate of the machine (fire, lightning, theft) - a remote backup server provides off-site protection.|Also warns when the snapshot count or backup tree size grow past the configured retention (disk full prevention)."

# Healthcheck for the nightly backup job
f_check_cache "symbios-healthcheck-backup" || return 2>/dev/null || true

# The backup is optional (backup_enabled in the inventory, default off).
# A host without a backup job has nothing to report.
if [[ "$(f_symbios_var backup_enabled false)" != "true" ]]
then
  return 0
fi

g_backup_marker="${g_log_dir}/backup-last-success"

if [[ ! -f "$g_backup_marker" ]]
then
  g_echo_error "No successful backup yet - open Settings -> Backup and run one."
else
  # Older than two days means at least two nightly runs were missed
  g_backup_age_hours=$(( ($(date +%s) - $(head -1 "$g_backup_marker" 2>/dev/null || echo 0)) / 3600 ))
  if [[ "$g_backup_age_hours" -ge 48 ]]
  then
    g_echo_error "Last successful backup is $g_backup_age_hours hours old."
  fi
fi

# Backup existence and freshness (warnings, not errors): the marker check
# above already fails when the nightly job itself is broken, here we report
# the protection gap. The newest backup anywhere is the max of the local
# snapshot dates and the date of the last successful engine run - remote
# runs create no local snapshots, so the marker (epoch seconds) is their
# only trace on this host.
g_bk_newest_local=""
if [[ -r "${g_git_root}/scripts/symbios-backup-lib.sh" ]]
then
  source "${g_git_root}/scripts/symbios-backup-lib.sh"
  f_bk_read_vars
  g_bk_newest_local="$(f_bk_list_local_dates | head -1)"
fi
g_bk_newest="${g_bk_newest_local}"
if [[ -f "$g_backup_marker" ]]
then
  # Last successful run date (local or remote mode) from the marker timestamp
  g_bk_last_ok_date="$(date -d "@$(head -1 "$g_backup_marker" 2>/dev/null)" +%F 2>/dev/null || true)"
  if [[ -n "$g_bk_last_ok_date" && ( -z "$g_bk_newest" || "$g_bk_last_ok_date" > "$g_bk_newest" ) ]]
  then
    g_bk_newest="$g_bk_last_ok_date"
  fi
fi
# Staleness limit in days, configurable via the inventory (default 7)
g_bk_max_age_days="$(f_symbios_var backup_max_age_days "7")"
[[ "$g_bk_max_age_days" =~ ^[0-9]+$ && "$g_bk_max_age_days" -gt 0 ]] || g_bk_max_age_days=7
if [[ -z "$g_bk_newest" ]]
then
  g_echo_warn "No backup exists yet (local or remote) - run one via Settings -> Backup."
else
  # Age of the newest backup in whole days (ISO dates compare lexicographically)
  g_bk_age_days=$(( ( $(date +%s) - $(date -d "$g_bk_newest" +%s 2>/dev/null || echo 0) ) / 86400 ))
  if [[ "$g_bk_age_days" -ge "$g_bk_max_age_days" ]]
  then
    g_echo_warn "Newest backup is ${g_bk_age_days} days old (${g_bk_newest}) - all backups are older than ${g_bk_max_age_days} days."
  fi
fi

# Off-site coverage (warning): while no remote target is configured, every
# backup lives on the same machine as the data it protects - fire, lightning
# or theft destroy both at once. A remote backup server closes that gap.
if [[ -r "${g_git_root}/scripts/symbios-backup-lib.sh" ]] && ! f_bk_has_targets
then
  g_echo_warn "Backups are stored locally only - they do not protect against hardware failure or fire. Configure a remote backup server in Settings -> Backup."
fi

# Cron entry must be active
if ! grep -q "backup.sh" /etc/cron.d/backup_local 2>/dev/null
then
  g_echo_error "Backup cron entry /etc/cron.d/backup_local is missing."
fi

# Snapshot count + backup tree size as warning indicators (disk full
# prevention). Values come from the status JSON written by the backup engine
# (no expensive du on every runcheck tick).
g_backup_status="${g_log_dir}/backup-status.json"
if [[ -f "$g_backup_status" ]]
then
  g_bk_count=$(grep -o '"snapshot_count":[0-9]*' "$g_backup_status" | head -1 | cut -d: -f2)
  g_bk_size_mb=$(grep -o '"snapshot_size_mb":[0-9]*' "$g_backup_status" | head -1 | cut -d: -f2)
  # Expected max snapshot count = keep_daily + keep_weekly + keep_monthly
  # plus a small slack for monthly-alias dailies. Configurable via inventory.
  g_bk_keep_daily=$(f_symbios_var backup_keep_daily "7")
  g_bk_keep_weekly=$(f_symbios_var backup_keep_weekly "4")
  g_bk_keep_monthly=$(f_symbios_var backup_keep_monthly "6")
  if [[ "$g_bk_count" =~ ^[0-9]+$ && "$g_bk_count" -gt $(( g_bk_keep_daily + g_bk_keep_weekly + g_bk_keep_monthly + 3 )) ]]
  then
    g_echo_error "Backup snapshot count ${g_bk_count} exceeds retention (${g_bk_keep_daily}d+${g_bk_keep_weekly}w+${g_bk_keep_monthly}m) - check Settings -> Backup."
  fi
  # Backup tree size vs total data partition: warn past ~30%, error past 50%.
  # (30% of a 59G disk = ~18G of snapshots, well before the disk fills up;
  # the 3GB/15% free-space guard then protects the last stretch.)
  if [[ "$g_bk_size_mb" =~ ^[0-9]+$ && "$g_bk_size_mb" -gt 0 ]]
  then
    g_bk_total_mb=$(df -P -B1M "$g_data_root" 2>/dev/null | awk 'NR==2{print $2}')
    if [[ "$g_bk_total_mb" =~ ^[0-9]+$ && "$g_bk_total_mb" -gt 0 ]]
    then
      g_bk_share=$(( g_bk_size_mb * 100 / g_bk_total_mb ))
      if [[ "$g_bk_share" -gt 50 ]]
      then
        g_echo_error "Backup tree is ${g_bk_share}% of the data disk (${g_bk_size_mb} MB) - dangerously large, prune snapshots."
      elif [[ "$g_bk_share" -gt 30 ]]
      then
        g_echo_error "Backup tree is ${g_bk_share}% of the data disk (${g_bk_size_mb} MB) - consider raising retention or freeing space."
      fi
    fi
  fi
fi
