CHECK_CATEGORY="services"
CHECK_TITLE="Backup"
CHECK_DESC="Checks that backups ran recently and are not stored locally only."
CHECK_DETAIL="Watches the success marker written by the nightly backup job.|Daily snapshots protect all data below /symbios (services, databases, configuration).|If this fails, no recent backup exists - check Settings -> Backup (it shows the restic error log of the last run).|Warns when no backup exists at all or the newest one is older than 7 days (limit configurable via backup_max_age_days in the inventory).|Also warns while only the local restic repository is configured: it shares the fate of the machine (fire, lightning, theft) - a remote backup server provides off-site protection.|Also warns when the local snapshot count or repository size grow past the configured retention (disk full prevention).|Also warns when the configuration backup of a registered OpenWrt system is missing or older than 2 days - an offline router fails silently otherwise."

# Healthcheck for the nightly backup job
f_check_cache "symbios-healthcheck-backup" || return 2>/dev/null || true

# The backup is optional (backup_enabled in the inventory, default off).
# A host without a backup job has nothing to report.
if [[ "$(f_symbios_var backup_enabled false)" != "true" ]]
then
  return 0
fi

g_backup_marker="${g_log_dir}/backup-last-success"
g_backup_status="${g_log_dir}/backup-status.json"

# A failed engine run is the most specific signal: the status JSON holds
# the captured restic errors (rendered on the Settings -> Backup page).
if [[ -r "$g_backup_status" ]] \
  && grep -q '"state":"error"' "$g_backup_status"
then
  g_echo_error "Last backup run failed - open Settings -> Backup for the error log."
fi

if [[ ! -f "$g_backup_marker" ]]
then
  g_echo_error "No successful backup yet - open Settings -> Backup and run one."
else
  # Older than two days means at least two nightly runs were missed
  g_backup_age_hours=$(( ($(date +%s) - $(head -1 "$g_backup_marker" 2>/dev/null || echo 0)) / 3600 ))
  if [[ "$g_backup_age_hours" -ge 48 ]]
  then
    g_echo_error "Last successful backup is $g_backup_age_hours hours old."
  fi
fi

# Backup existence and freshness (warnings, not errors): the marker
# timestamp is the only on-host trace of a successful run for remote
# targets; in local mode it is backed by the snapshot stats below.
g_bk_last_ok_date="$(date -d "@$(head -1 "$g_backup_marker" 2>/dev/null)" +%F 2>/dev/null || true)"
# Staleness limit in days, configurable via the inventory (default 7)
g_bk_max_age_days="$(f_symbios_var backup_max_age_days "7")"
[[ "$g_bk_max_age_days" =~ ^[0-9]+$ && "$g_bk_max_age_days" -gt 0 ]] || g_bk_max_age_days=7
if [[ -z "$g_bk_last_ok_date" ]]
then
  g_echo_warn "No backup exists yet (local or remote) - run one via Settings -> Backup."
else
  # Age of the newest backup in whole days (ISO dates compare lexicographically)
  g_bk_age_days=$(( ( $(date +%s) - $(date -d "$g_bk_last_ok_date" +%s 2>/dev/null || echo 0) ) / 86400 ))
  if [[ "$g_bk_age_days" -ge "$g_bk_max_age_days" ]]
  then
    g_echo_warn "Newest backup is ${g_bk_age_days} days old (${g_bk_last_ok_date}) - all backups are older than ${g_bk_max_age_days} days."
  fi
fi

# Off-site coverage (warning): while no remote target is configured, every
# backup lives on the same machine as the data it protects - fire, lightning
# or theft destroy both at once. A remote backup server closes that gap.
if [[ -r "${g_git_root}/scripts/symbios-backup-lib.sh" ]]
then
  source "${g_git_root}/scripts/symbios-backup-lib.sh"
  f_bk_read_vars
  if ! f_bk_has_targets
  then
    g_echo_warn "Backups are stored locally only - they do not protect against hardware failure or fire. Configure a remote backup server in Settings -> Backup."
  fi
fi

# Cron entry must be active
if ! grep -q "backup.sh" /etc/cron.d/backup_local 2>/dev/null
then
  g_echo_error "Backup cron entry /etc/cron.d/backup_local is missing."
fi

# Snapshot count + repository size of the LOCAL restic repository as
# warning indicators (disk full prevention). Values come from the status
# JSON written by the backup engine (no expensive restic/du call on every
# runcheck tick); remote repositories apply their own retention every run.
if [[ -r "$g_backup_status" ]]
then
  g_bk_count=$(grep -o '"snapshot_count":[0-9]*' "$g_backup_status" | head -1 | cut -d: -f2)
  g_bk_size_mb=$(grep -o '"snapshot_size_mb":[0-9]*' "$g_backup_status" | head -1 | cut -d: -f2)
  # Expected max snapshot count = keep_daily + keep_weekly + keep_monthly
  # plus a small slack. Configurable via inventory (defaults 7/4/9999).
  g_bk_keep_daily=$(f_symbios_var backup_keep_daily "7")
  g_bk_keep_weekly=$(f_symbios_var backup_keep_weekly "4")
  g_bk_keep_monthly=$(f_symbios_var backup_keep_monthly "9999")
  if [[ "$g_bk_count" =~ ^[0-9]+$ && "$g_bk_count" -gt 0 ]] \
    && [[ "$g_bk_keep_daily" =~ ^[0-9]+$ ]] && [[ "$g_bk_keep_weekly" =~ ^[0-9]+$ ]] \
    && [[ "$g_bk_keep_monthly" =~ ^[0-9]+$ ]] \
    && [[ "$g_bk_count" -gt $(( g_bk_keep_daily + g_bk_keep_weekly + g_bk_keep_monthly + 3 )) ]]
  then
    g_echo_error "Backup snapshot count ${g_bk_count} exceeds retention (${g_bk_keep_daily}d+${g_bk_keep_weekly}w+${g_bk_keep_monthly}m) - check Settings -> Backup."
  fi
  # Repository size vs total data partition: warn past ~30%, error past 50%.
  # (30% of a 59G disk = ~18G of snapshots, well before the disk fills up;
  # the 3GB/15% free-space guard then protects the last stretch.)
  if [[ "$g_bk_size_mb" =~ ^[0-9]+$ && "$g_bk_size_mb" -gt 0 ]]
  then
    g_bk_total_mb=$(df -P -B1M "$g_data_root" 2>/dev/null | awk 'NR==2{print $2}')
    if [[ "$g_bk_total_mb" =~ ^[0-9]+$ && "$g_bk_total_mb" -gt 0 ]]
    then
      g_bk_share=$(( g_bk_size_mb * 100 / g_bk_total_mb ))
      if [[ "$g_bk_share" -gt 50 ]]
      then
        g_echo_error "Backup tree is ${g_bk_share}% of the data disk (${g_bk_size_mb} MB) - dangerously large, prune snapshots."
      elif [[ "$g_bk_share" -gt 30 ]]
      then
        g_echo_warn "Backup tree is ${g_bk_share}% of the data disk (${g_bk_size_mb} MB) - consider raising retention or freeing space."
      fi
    fi
  fi
fi

# Configuration backups of the registered OpenWrt systems (warning): the
# nightly module logs an unreachable router and keeps going, so without this
# check a router that is offline for weeks would simply have no backup.
# Reads the registry only - the module writes the archives.
g_ow_registry="${g_config_dir}/external-systems.yml"
if [[ -r "${g_ow_registry}" ]] && command -v yq > /dev/null
then
  while IFS= read -r g_ow_id
  do
    [[ -n "${g_ow_id}" ]] || continue
    g_ow_newest=$(ls -1t "${g_backup_root}/openwrt/${g_ow_id}/${g_ow_id}"-*.tar.gz 2> /dev/null | head -1)
    if [[ -z "${g_ow_newest}" ]]
    then
      g_echo_warn "OpenWrt ${g_ow_id}: no configuration backup yet."
      continue
    fi
    g_ow_age_days=$(( ( $(date +%s) - $(date -r "${g_ow_newest}" +%s) ) / 86400 ))
    if [[ "${g_ow_age_days}" -ge 2 ]]
    then
      g_echo_warn "OpenWrt ${g_ow_id}: last configuration backup is ${g_ow_age_days} days old (${g_ow_newest##*/})."
    fi
  done <<< "$(yq -r '.external_systems[] | select(.type == "OpenWrt") | .id' "${g_ow_registry}" 2> /dev/null)"
fi
