CHECK_CATEGORY="system"
CHECK_TITLE="Disk Space"
CHECK_DESC="Checks if any filesystem is almost full (over 98%)."
CHECK_DETAIL="Runs df -al and scans all mounted filesystems.|Alerts if any partition exceeds 98% usage.|Excludes pseudo-filesystems like /proc and /rom."

# Alert when any filesystem exceeds 98% disk usage
# Process substitution keeps the loop in the current shell, so the error flag
# set by g_echo_error is visible to runchecks.sh (a plain pipeline would lose it)
while read g_i
do
  g_disk=`echo $g_i | cut -d" " -f1`
  g_usa=`echo $g_i | cut -d" " -f2`
  if [[ $g_usa -gt 98 ]]
  then
    g_echo_error "Space of $g_disk full: $g_usa%"
  fi
done < <(df -al | grep -E -v ' - |Mounted on|/rom' | sed 's/  */ /g; s/\%//' | cut -d" " -f1,5 | sort -u)
