CHECK_CATEGORY="network"
CHECK_TITLE="Two-Factor Auth"
CHECK_DESC="Shows whether two-factor authentication is enabled (informational)."
CHECK_DETAIL="Reads the twofa_enabled setting from inventory.yml.|Displays current status but never triggers an error.|2FA is optional but strongly recommended for security.|Enable it in Settings > Auth if not active."

# Check: Verify two-factor authentication status in inventory config
f_check_cache "symbios-healthcheck-twofa" || return 2>/dev/null || true

g_twofa=$(f_symbios_var twofa_enabled "")
if [[ "${g_twofa}" == "true" || "${g_twofa}" == "yes" || "${g_twofa}" == "1" ]]
then
  g_twofa_status="enabled"
else
  g_twofa_status="disabled"
fi
# 2FA is optional - no error if disabled
