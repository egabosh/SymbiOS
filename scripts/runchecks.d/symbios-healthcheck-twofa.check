# Check: Verify two-factor authentication status in inventory config
f_check_cache "symbios-healthcheck-twofa" || return 2>/dev/null || true

g_twofa=$(f_symbios_var twofa_enabled "")
if [[ "${g_twofa}" == "true" || "${g_twofa}" == "yes" || "${g_twofa}" == "1" ]]
then
  g_twofa_status="enabled"
else
  g_twofa_status="disabled"
fi
# 2FA is optional - no error if disabled
