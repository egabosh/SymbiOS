CHECK_CATEGORY="services"
CHECK_TITLE="SSO Login"
CHECK_DESC="Checks if the single sign-on service (Authelia) is reachable."
CHECK_DETAIL="Executes wget inside the Authelia container|to query http://localhost:9091/api/health.|Authelia handles 2FA login for all protected services.|If unreachable, no user can log in to any web app."

# Healthcheck for authelia (HTTP health endpoint)
f_check_cache "symbios-healthcheck-authelia" || return 2>/dev/null || true
if ! docker exec symbios-base-authelia wget -q -O /dev/null --timeout=10 http://localhost:9091/api/health 2>/dev/null
then
  g_echo_error "Healthcheck failed for symbios-base-authelia: HTTP health endpoint unreachable"
fi
