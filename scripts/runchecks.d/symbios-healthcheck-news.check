CHECK_CATEGORY="news"
CHECK_TITLE="SymbiOS News"
CHECK_DESC="Reports unread security/critical news and a feed that has been unreachable for hours."
CHECK_DETAIL="Reads the hourly news snapshot in <log>/news.json.|Warns while alert items are unmarked or the last successful fetch is more than six hours old.|Mark the items as read on the News page to clear the warning."

# The snapshot is written by symbios-news.sh refresh (hourly cron). Before the
# first run, or while the feed is disabled, there is nothing to report.
g_news_snapshot="${g_log_dir}/news.json"
if [[ ! -s "${g_news_snapshot}" ]]
then
  exit 0
fi

g_news_status="$(jq -r '.status // "ok"' "${g_news_snapshot}" 2>/dev/null)"
if [[ "${g_news_status}" == "disabled" ]]
then
  exit 0
fi

g_news_unread="$(jq -r '.unread // 0' "${g_news_snapshot}" 2>/dev/null)"
if [[ "${g_news_unread}" =~ ^[0-9]+$ && "${g_news_unread}" -gt 0 ]]
then
  g_news_titles="$(jq -r '.unread_alerts | map(.title) | join(", ")' "${g_news_snapshot}" 2>/dev/null)"
  g_echo_warn "${g_news_unread} unread security/critical news item(s): ${g_news_titles}"
fi

# A single failed fetch must not notify: only a feed that has been unreachable
# for hours is worth a warning (the snapshot keeps the last successful time).
if [[ "${g_news_status}" == "error" ]]
then
  g_news_updated="$(jq -r '.updated // ""' "${g_news_snapshot}" 2>/dev/null)"
  g_news_error="$(jq -r '.error // ""' "${g_news_snapshot}" 2>/dev/null)"
  g_news_last=0
  if [[ -n "${g_news_updated}" ]]
  then
    g_news_last="$(date -u -d "${g_news_updated}" +%s 2>/dev/null || echo 0)"
  fi
  g_news_age=$(( $(date -u +%s) - g_news_last ))
  if [[ "${g_news_age}" -gt 21600 ]]
  then
    g_echo_warn "News feed unreachable: ${g_news_error}"
  fi
fi
