CHECK_CATEGORY="services"
CHECK_TITLE="WireGuard Client"
CHECK_DESC="Checks that all enabled WireGuard client tunnels are up."
CHECK_DETAIL="Verifies wg-quick@<name>.service is active and the tunnel interface carries an IP.|Warns when an enabled tunnel has no peer handshake yet.|If down, all hosts behind the tunnel are unreachable."

# Healthcheck for WireGuard client tunnels (enabled flag in inventory).
f_check_cache "symbios-healthcheck-wireguard" || return 2>/dev/null || true

# Read wireguard_clients from the inventory and verify each enabled tunnel is
# active and its interface carries an IP. A missing handshake is only a
# warning (a fresh tunnel has not talked to its peer yet). An empty dict means
# the feature is unused. Keep the BAD/WARN prefixes: the caller parses them.
f_rows="$(f_symbios_var_json wireguard_clients \
  | jq -r 'def truthy:
             if . == false or . == null or . == 0 or . == "" or
                . == [] or . == {} then false else true end;
           to_entries[]
           | select((.value | type) == "object")
           | select(.value.enabled | truthy)
           | .key' 2>/dev/null || true)"
f_bad=""
while read -r f_name
do
  [[ -n "${f_name}" ]] || continue
  if ! systemctl is-active "wg-quick@${f_name}" >/dev/null 2>&1
  then
    f_bad="${f_bad}${f_bad:+$'\n'}BAD ${f_name} (service down)"
    continue
  fi
  f_out="$(ip -o -4 addr show dev "${f_name}" 2>/dev/null || true)"
  if [[ "${f_out}" != *"inet "* ]]
  then
    f_bad="${f_bad}${f_bad:+$'\n'}BAD ${f_name} (no IP on ${f_name})"
    continue
  fi
  # latest-handshakes prints "<pubkey>\t<epoch>", 0 = never.
  f_handshakes="$(wg show "${f_name}" latest-handshakes 2>/dev/null || true)"
  f_seen=0
  while read -r f_pub f_stamp
  do
    [[ -n "${f_stamp}" && "${f_stamp}" != "0" ]] && f_seen=1
  done <<< "${f_handshakes}"
  if [[ "${f_seen}" -eq 0 ]]
  then
    f_bad="${f_bad}${f_bad:+$'\n'}WARN ${f_name} (no handshake yet)"
  fi
done <<< "${f_rows}"

# Split the verdict lines: BAD -> error (check fails), WARN -> warning.
f_errors=""
f_warns=""
while IFS= read -r f_line
do
  case "${f_line}" in
    "BAD "*) f_errors="${f_errors}${f_errors:+, }${f_line#BAD }" ;;
    "WARN "*) f_warns="${f_warns}${f_warns:+, }${f_line#WARN }" ;;
  esac
done <<< "${f_bad}"

if [[ -n "${f_errors}" ]]
then
  g_echo_error "WireGuard tunnels down: ${f_errors}"
fi
if [[ -n "${f_warns}" ]]
then
  g_echo_warn "WireGuard tunnels without handshake: ${f_warns}"
fi
