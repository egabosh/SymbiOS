# Check: Verify the server is reachable from the internet (DNS + ports 80/443)
f_check_cache "symbios-healthcheck-reachability" || return 2>/dev/null || true

# Only meaningful when DNS is configured
g_base_domain=$(f_symbios_var base_domain "" 2>/dev/null)
if [[ -z "$g_base_domain" ]]
then
  g_echo_error "Noch keine Domain konfiguriert - Erreichbarkeit kann nicht geprüft werden"
  return 2>/dev/null || true
fi

# Run the external reachability probe
g_result=$(symbios-external-check.sh -d "$g_base_domain" -p 80,443 2>/dev/null)
if [[ -z "$g_result" ]]
then
  g_echo_error "Healthcheck failed for reachability: probe produced no output"
  return 2>/dev/null || true
fi

g_ok=""
if [[ "$g_result" == *'"ok":true'* ]]
then
  g_ok="true"
fi
g_summary=$(f_json_get "$g_result" "summary")

if [[ "$g_ok" == "true" ]]
then
  # Report OK status implicitly by producing no error
  :
else
  g_echo_error "Server is not reachable from the internet: ${g_summary:-unknown reason}"
fi
