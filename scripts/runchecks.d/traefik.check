CHECK_CATEGORY="network"
CHECK_TITLE="Reverse Proxy"
CHECK_DESC="Checks if all websites behind Traefik are reachable."
CHECK_DETAIL="Collects all hostnames from Docker Compose Traefik labels.|Adds missing hosts to /etc/hosts (指向 Traefik).|Verifies each host via HTTP wget with retries.|Tracks persistent 502 errors (warns after 15 minutes).|401/403 responses are expected (Authelia protection).|API-only backends (flagged per forward) answer 501/404 on / without a web UI - any HTTP response counts as alive.|Routes of sleeping WoL targets are skipped via the asleep list."

# Healthcheck for traefik host reachability
# Collect all hostnames from docker-compose files
f_symbios_traefik_hosts

# Ensure each host has a local /etc/hosts entry
cat "$g_tmp/hosts" | cut -d '`' -f2 | sort -u | while read f_host
do
  # Skip hosts checked within the last 5 minutes
  if find -mmin -5 "/tmp/$f_host" >/dev/null 2>&1 | grep -q "$f_host"
  then
    continue
  fi
  # Add host to /etc/hosts if not already present
  if ! grep -E -q "192.168.41.1  $f_host" /etc/hosts
  then
    echo "192.168.41.1  $f_host" >>/etc/hosts
  fi
done

# Verify each host is reachable via HTTP
# Process substitution keeps the loop in the current shell, so the error flag
# set by g_echo_error is visible to runchecks.sh (a plain pipeline would lose it)
while read f_host
do
  # Skip hosts checked within the last 5 minutes
  if find -mmin -5 "/tmp/$f_host" >/dev/null 2>&1 | grep -q "$f_host"
  then
    continue
  fi
  # Skip routes of sleeping WoL targets (suspend writes their hostnames to
  # the asleep list; expected 502s while sleeping must not alert). The idle
  # watcher removes them once the target is reachable again.
  if [[ -f "${g_config_dir}/power/asleep" ]] && grep -qxF "$f_host" "${g_config_dir}/power/asleep" 2>/dev/null
  then
    g_skipped=$(( ${g_skipped:-0} + 1 ))
    continue
  fi
  # Attempt HTTP connection with wget
  if ! wget --dns-timeout=120 -t5 --waitretry=120 --connect-timeout=300 --read-timeout=15 "http://${f_host}" >"${g_tmp}/traefik-wget-check" -O /dev/null 2>&1
  then
    # Report error only if it is not a known-auth response
    if ! grep -E -q "401 Unauthorized|403 Forbidden|415 Unsupported Media Type" "${g_tmp}/traefik-wget-check"
    then
      # API-only backends (no web UI) answer 501/404 on /. The flag lives in
      # the forward's provider snippet (rendered from forwards.yml), so this
      # stays configurable instead of hardcoding hostnames here.
      f_api=""
      for f_prov in "${g_base_services_root}/traefik/providers/"*.yml
      do
        if grep -qF "Host(\`${f_host}\`)" "$f_prov" 2>/dev/null && grep -q "# api-backend: true" "$f_prov"
        then
          f_api="1"
          break
        fi
      done
      if [[ -n "$f_api" ]] && grep -E -q "501 Not Implemented|404 Not Found" "${g_tmp}/traefik-wget-check"
      then
        if [[ -f "${g_tmp}/$f_host-502" ]]
        then
          rm "${g_tmp}/$f_host-502"
        fi
      else
        g_echo_error "Error while connecting ${f_host} with wget:

$(cat ${g_tmp}/traefik-wget-check)"
      fi
    else
      if [[ -f "${g_tmp}/$f_host-502" ]]
      then
        rm "${g_tmp}/$f_host-502"
      fi
    fi
    # Track persistent 502 errors
    if grep -E -q "502 Bad Gateway" "${g_tmp}/traefik-wget-check"
    then
      if [[ -s "${g_tmp}/$f_host-502" ]] && find "${g_tmp}/$f_host-502" | grep "$f_host-502" -mmin +15
      then
        g_echo_error "Error while connecting ${f_host} with wget:
$(cat ${g_tmp}/traefik-wget-check)"
      else
        date >"${g_tmp}/$f_host-502"
      fi
    fi
  fi
done < <(cat "$g_tmp/hosts" | grep -v tcp | cut -d '`' -f2 | sort -u)

if [[ "${g_skipped:-0}" -gt 0 ]]
then
  g_echo_note "Skipped ${g_skipped} route(s) of sleeping WoL targets"
fi
