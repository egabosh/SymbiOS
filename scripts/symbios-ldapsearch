#!/bin/bash
# SymbiOS LDAP search wrapper - uses the host port to bypass Traefik TLS.
# The read-only bind password is read from env.openldap and passed to ldapsearch
# on stdin (-W), so it never appears in argv.

# Source LDAP credentials from environment file.
. /symbios/base-services/ldap/env.openldap

# Pass the password on stdin with -W (a trailing newline is required).
ldapsearch -x -H ldap://127.0.0.1:389 \
  -D "cn=readuser,dc=openldap,dc=local" -W \
  -b "dc=openldap,dc=local" "$@" <<< "${LDAP_READUSER_PASSWORD}"
f_rc=$?

# Clear credentials from environment.
unset LDAP_ADMIN_PASSWORD LDAP_READUSER_PASSWORD

exit $f_rc
