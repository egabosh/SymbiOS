{# SymbiOS - generated by services/wordpress.yml from services/wordpress/templates/docker-compose.yml.j2.
   Do not edit by hand; change wordpress_instances in inventory.yml and re-run the playbook. #}
name: symbios-wordpress

networks:
  symbios_services:
    external: true
  symbios-wordpress:
    driver: bridge

services:
  # One shared MariaDB for all WordPress instances.
  db:
    image: mariadb:lts
    container_name: symbios-wordpress-db
    restart: unless-stopped
    env_file:
      - /symbios/base-services/_defaults/mariadb/mariadb.env
    environment:
      MARIADB_ROOT_PASSWORD: ${WORDPRESS_DB_ROOT_PASSWORD}
      MARIADB_AUTO_UPGRADE: "1"
    volumes:
      - ./db-data:/var/lib/mysql
      - /etc/localtime:/etc/localtime:ro
      - /symbios/base-services/_defaults/mariadb/99-server.cnf:/etc/mysql/mariadb.conf.d/99-server.cnf:ro
    networks:
      - symbios-wordpress
    healthcheck:
      test: ["CMD", "mariadb-admin", "ping", "-h", "localhost", "--silent"]
      interval: 5s
      timeout: 3s
      retries: 30
      start_period: 60s

{% for wp in wordpress_instances | default([]) %}
  wordpress-{{ wp.name }}:
    image: wordpress
    container_name: symbios-wordpress-{{ wp.name }}
    restart: unless-stopped
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: ${WORDPRESS_{{ wp.name | upper | regex_replace('-', '_') }}_DB_USER}
      WORDPRESS_DB_PASSWORD: ${WORDPRESS_{{ wp.name | upper | regex_replace('-', '_') }}_DB_PASSWORD}
      WORDPRESS_DB_NAME: ${WORDPRESS_{{ wp.name | upper | regex_replace('-', '_') }}_DB_NAME}
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_HOME', 'https://{{ wp.domain }}');
        define('WP_SITEURL', 'https://{{ wp.domain }}');
    volumes:
      - ./{{ wp.name }}-data:/var/www/html
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      db:
        condition: service_healthy
    networks:
      - symbios-wordpress
      - symbios_services

{% if wp.phpmyadmin | default(false) %}
  phpmyadmin-{{ wp.name }}:
    image: phpmyadmin
    container_name: symbios-wordpress-phpmyadmin-{{ wp.name }}
    restart: unless-stopped
    environment:
      PMA_ARBITRARY: "0"
      PMA_HOST: db
      PMA_USER: ${WORDPRESS_{{ wp.name | upper | regex_replace('-', '_') }}_DB_USER}
      PMA_PASSWORD: ${WORDPRESS_{{ wp.name | upper | regex_replace('-', '_') }}_DB_PASSWORD}
    depends_on:
      db:
        condition: service_healthy
    networks:
      - symbios-wordpress
      - symbios_services
{% endif %}
{% endfor %}