{# SymbiOS - generated by services/wordpress.yml from services/wordpress/templates/traefik-wordpress.yml.j2.
   Do not edit by hand; change wordpress_instances in inventory.yml and re-run the playbook. #}
http:
  routers:
{% for wp in wordpress_instances | default([]) %}
    wordpress-{{ wp.name }}:
      rule: "Host(`{{ wp.domain }}`){% for alias in wp.aliases | default([]) %} || Host(`{{ alias }}`){% endfor %}"
      service: wordpress-{{ wp.name }}
      entryPoints:
        - "https"
      tls:
        certResolver: {{ acme_resolver }}
      middlewares:
        - "secHeaders@file"
{% if wp.basic_auth | default(false) | bool %}
        - "default-basic-auth@file"
{% endif %}
{% if wp.phpmyadmin | default(false) %}
    wordpress-{{ wp.name }}-phpmyadmin:
      rule: "Host(`{{ wordpress_phpmyadmin_domains[wp.name] }}`)"
      service: wordpress-{{ wp.name }}-phpmyadmin
      entryPoints:
        - "https"
      tls:
        certResolver: {{ acme_resolver }}
      middlewares:
        - "secHeaders@file"
        - "authelia@file"
{% endif %}
{% endfor %}
  services:
{% for wp in wordpress_instances | default([]) %}
    wordpress-{{ wp.name }}:
      loadBalancer:
        servers:
          - url: "http://symbios-wordpress-{{ wp.name }}:80"
{% if wp.phpmyadmin | default(false) %}
    wordpress-{{ wp.name }}-phpmyadmin:
      loadBalancer:
        servers:
          - url: "http://symbios-wordpress-phpmyadmin-{{ wp.name }}:80"
{% endif %}
{% endfor %}