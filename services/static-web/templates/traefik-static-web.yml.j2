{# SymbiOS - generated by services/static-web.yml from services/static-web/templates/traefik-static-web.yml.j2.
   Do not edit by hand; change the static web instances in
   <config>/services/static-web/instances.yml and re-run the playbook.
   Loops do not survive blockinfile (indentation drift), hence a real template. #}
http:
  routers:
{% for site in static_web_instances | default([]) %}
    static-web-{{ site.name }}:
      rule: "Host(`{{ site.domain }}`){% for alias in site.aliases | default([]) %} || Host(`{{ alias }}`){% endfor %}"
      service: static-web-{{ site.name }}
      entryPoints:
        - "https"
      tls:
        certResolver: {{ acme_resolver }}
      middlewares:
        - "secHeaders@file"
{% if not (site.public | default(false) | bool) %}
        - "authelia@file"
{% endif %}
{% endfor %}
  services:
{% for site in static_web_instances | default([]) %}
    static-web-{{ site.name }}:
      loadBalancer:
        servers:
          - url: "http://static-web-{{ site.name }}:80"
{% endfor %}
