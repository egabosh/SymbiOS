{# SymbiOS - generated by services/static-web.yml from services/static-web/templates/traefik-static-web.yml.j2.
   Do not edit by hand; change static_web_sites in inventory.yml and re-run the playbook.
   Loops do not survive blockinfile (indentation drift), hence a real template. #}
http:
  routers:
{% for site in static_web_sites %}
    {{ site.name }}:
      rule: "Host(`{{ site.domain }}`)"
      entryPoints:
        - "https"
      service: {{ service_name }}
      tls:
        certResolver: {{ acme_resolver }}
      middlewares:
        - "secHeaders@file"
{% if site.name in static_web_auth_sites %}
        - "authelia@file"
{% endif %}
{% endfor %}
  services:
    {{ service_name }}:
      loadBalancer:
        servers:
          - url: "http://{{ service_name }}:80"
