{# SymbiOS - generated by services/static-web.yml from services/static-web/templates/docker-compose.yml.j2.
   Do not edit by hand; change static_web_sites in inventory.yml and re-run the playbook.
   Loops do not survive blockinfile (indentation drift), hence a real template. #}
name: ""

services:

  {{ service_name }}:
    image: nginx:latest
    container_name: {{ service_name }}
    restart: unless-stopped
    volumes:
      - /etc/localtime:/etc/localtime:ro
{% for site in static_web_sites %}
      - {{ site.docroot | default('./htdocs/' + site.name) }}:/usr/share/nginx/html/{{ site.name }}:ro
{% endfor %}
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
    networks:
      - symbios_services

networks:
  symbios_services:
    external: true
