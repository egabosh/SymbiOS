{# SymbiOS - generated by services/static-web.yml from services/static-web/templates/docker-compose.yml.j2.
   Do not edit by hand; change the static web instances in
   <config>/services/static-web/instances.yml and re-run the playbook.
   Loops do not survive blockinfile (indentation drift), hence a real template. #}
name: ""

services:
{% for site in static_web_instances | default([]) %}
  static-web-{{ site.name }}:
    image: nginx:latest
    container_name: static-web-{{ site.name }}
    restart: unless-stopped
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./nginx/{{ site.name }}:/etc/nginx/conf.d:ro
{% if site.docroot is defined %}
      # Long syntax with create_host_path:false: fail closed when the
      # document root is missing instead of serving an empty directory.
      - type: bind
        source: "{{ site.docroot }}"
        target: /usr/share/nginx/html
        read_only: true
        bind:
          create_host_path: false
{% else %}
      - ./htdocs/{{ site.name }}:/usr/share/nginx/html:ro
{% endif %}
    networks:
      - symbios_services
{% endfor %}

networks:
  symbios_services:
    external: true
