{# SymbiOS - generated by services/navidrome.yml from services/navidrome/templates/docker-compose.yml.j2.
   Do not edit by hand; re-run the playbook instead. A real template (not
   blockinfile) because the music mount is conditional multiline YAML. #}
name: ""

services:
  navidrome:
    image: deluan/navidrome:latest
    container_name: navidrome
    restart: unless-stopped
    environment:
      ND_SCANSCHEDULE: 24h
      ND_LOGLEVEL: warn
      ND_SESSIONTIMEOUT: 24h
      ND_ENABLEINSIGHTSCOLLECTOR: false
      ND_LASTFM_ENABLED: false
      ND_LISTENBRAINZ_ENABLED: false
      ND_SCANNER_PURGEMISSING: always
      ND_EXTAUTH_TRUSTEDSOURCES: "0.0.0.0/0"
      ND_ENABLEUSEREDITING: "false"
    networks:
      - symbios_services
    user: "33{{ (':' + (navidrome_music_gid | string)) if navidrome_music_gid else '' }}"
    volumes:
      - ./navidrome-data:/data
      - /etc/localtime:/etc/localtime:ro
{% if navidrome_music_path %}
      # Long syntax with create_host_path:false: fail closed when the
      # volume is missing instead of starting against an empty /music
      # (the purger would wipe the index, see 7.8).
      - type: bind
        source: {{ navidrome_music_path }}
        target: /music
        read_only: true
        bind:
          create_host_path: false
{% endif %}

networks:
  symbios_services:
    external: true
