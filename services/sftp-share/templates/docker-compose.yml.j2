{# SymbiOS - generated by services/sftp-share.yml from services/sftp-share/templates/docker-compose.yml.j2.
   Do not edit by hand; re-run the playbook instead. Loops do not survive
   blockinfile (indentation drift), hence a real template. #}
name: ""

services:
  sftp-share:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: sftp-share
    restart: unless-stopped
    ports:
      - "28:28"
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./ssh_host_ed25519_key:/etc/ssh/ssh_host_ed25519_key
      - ./ssh_host_ed25519_key.pub:/etc/ssh/ssh_host_ed25519_key.pub
      - ./sftp-share.conf:/etc/sftp-share.conf:ro
      - ./sftp-share-user.conf:/etc/sftp-share-user.conf
      - ./nslcd.conf:/etc/nslcd.conf:ro
      - ./nsswitch.conf:/etc/nsswitch.conf:ro
      - ./sftp-ldap-keys:/usr/local/bin/sftp-ldap-keys:ro
      # Long syntax with create_host_path:false throughout: fail closed
      # when the volume is missing instead of serving an empty chroot.
      - type: bind
        source: {{ sftp_share_datadir }}
        target: /sftp-share
        read_only: false
        bind:
          create_host_path: false
{% for m in sftp_share_extra_mounts | default([]) %}
      - type: bind
        source: {{ m.src }}
        target: {{ m.dest }}
        read_only: {{ 'false' if (m.mode | default('rw')) == 'rw' else 'true' }}
        bind:
          create_host_path: false
{% endfor %}
{% for wp in wordpress_sftp_mounts | default([]) %}
      - type: bind
        source: /symbios/services/wordpress/{{ wp.name }}-data
        target: /sftp-share/wordpress/{{ wp.name }}
        read_only: false
        bind:
          create_host_path: false
{% endfor %}
{% for site in static_web_sftp_mounts | default([]) %}
      - type: bind
        source: /symbios/services/static-web/htdocs/{{ site.name }}
        target: /sftp-share/static-web/{{ site.name }}
        read_only: false
        bind:
          create_host_path: false
{% endfor %}
    networks:
      - sftp-share--network
      - symbios_base_services

networks:
  sftp-share--network:
    driver: bridge
    driver_opts:
      com.docker.network.bridge.name: br-sftp-share
  symbios_base_services:
    external: true
