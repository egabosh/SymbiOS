{# SymbiOS - generated by services/redirects.yml from services/redirects/templates/traefik-redirects.yml.j2.
   Do not edit by hand; change the redirect instances in
   <config>/services/redirects/instances.yml and re-run the playbook. #}
http:
  routers:
{% for rd in redirect_instances | default([]) %}
    redirect-{{ rd.name }}:
      rule: "Host(`{{ rd.domain }}`){% for alias in rd.aliases | default([]) %} || Host(`{{ alias }}`){% endfor %}"
      service: noop@internal
      entryPoints:
        - "https"
      tls:
        certResolver: {{ acme_resolver }}
      middlewares:
        - "secHeaders@file"
        - "redirect-{{ rd.name }}"
{% endfor %}
  middlewares:
{% for rd in redirect_instances | default([]) %}
    # Keeps the path of the request, the target may carry a path prefix.
    redirect-{{ rd.name }}:
      redirectRegex:
        regex: "^https?://[^/]+/(.*)$"
        replacement: "{{ rd.target | regex_replace('/$', '') }}/${1}"
{% endfor %}
