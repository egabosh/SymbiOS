{# SymbiOS - generated by services/mailcow.yml from
   services/mailcow/templates/docker-compose.override.yml.j2.
   Do not edit by hand; change mailcow_bind_mounts in the playbook and
   re-run it.

   Two things are done here:
   1. The autoconfig/autodiscover nginx container is added (client
      autodiscovery). It joins symbios_services so Traefik can reach it
      by name.
   2. The upstream named volumes are replaced by plain bind mounts onto
      directories in the service directory. The mail store then lives as
      ordinary files under {{ mailcow_root }}/volumes/ and not as docker
      volumes - a "docker system prune -af" can not remove the mail
      data when the stack is down. #}
services:
  autoconfig:
    image: nginx:latest
    container_name: symbios-mailcow-autoconfig
    restart: unless-stopped
    volumes:
      - ./autoconfig/htdocs:/usr/share/nginx/html:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - autoconfig--network
      - symbios_services
{% for f_service, f_mounts in mailcow_bind_mounts.items() %}
  {{ f_service }}:
{% if f_service in mailcow_image_overrides %}
    image: {{ mailcow_image_overrides[f_service] }}
{% endif %}
    volumes:
{% for f_volume, f_target in f_mounts %}
      - type: bind
        source: "{{ mailcow_root }}/volumes/{{ f_volume }}"
        target: {{ f_target }}
        bind:
          create_host_path: false
{% endfor %}
{% endfor %}

networks:
  autoconfig--network:
    driver: bridge
    driver_opts:
      com.docker.network.bridge.name: br-mcow-acfg
  symbios_services:
    external: true
