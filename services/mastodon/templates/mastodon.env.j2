{# SymbiOS - generated by services/mastodon.yml. Do not edit by hand. #}
# Persistent instance environment for Mastodon {{ mastodon_instance.name }}
LOCAL_DOMAIN={{ mastodon_instance.domain }}
RAILS_ENV=production
NODE_ENV=production
BIND=0.0.0.0
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_LEVEL=warn
LOG_LEVEL=info
SINGLE_USER_MODE=false
DISABLE_AUTOMATIC_SWITCHING_TO_APPROVED_REGISTRATIONS=true

# Internal container names of this instance
DB_HOST={{ mastodon_instance.name }}-db
DB_PORT=5432
DB_NAME=mastodon
DB_USER=mastodon
DB_PASS={{ lookup('file', mastodon_secret_dir ~ '/db_password') }}
POSTGRES_DB=mastodon
POSTGRES_USER=mastodon
POSTGRES_PASSWORD={{ lookup('file', mastodon_secret_dir ~ '/db_password') }}
REDIS_HOST={{ mastodon_instance.name }}-redis
REDIS_PORT=6379
REDIS_PASSWORD={{ lookup('file', mastodon_secret_dir ~ '/redis_password') }}

# Rails and Web Push secrets (never rotate on a live instance)
SECRET_KEY_BASE={{ lookup('file', mastodon_secret_dir ~ '/secret_key_base') }}
OTP_SECRET={{ lookup('file', mastodon_secret_dir ~ '/otp_secret') }}
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY={{ lookup('file', mastodon_secret_dir ~ '/encryption_deterministic_key') }}
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT={{ lookup('file', mastodon_secret_dir ~ '/encryption_key_derivation_salt') }}
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY={{ lookup('file', mastodon_secret_dir ~ '/encryption_primary_key') }}
VAPID_PRIVATE_KEY={{ lookup('file', mastodon_secret_dir ~ '/vapid_private_key') }}
VAPID_PUBLIC_KEY={{ lookup('file', mastodon_secret_dir ~ '/vapid_public_key') }}

# Outgoing mail
SMTP_SERVER={{ mastodon_smtp_server }}
SMTP_PORT={{ mastodon_smtp_port }}
SMTP_LOGIN={{ mastodon_smtp_login }}
SMTP_PASSWORD={{ mastodon_smtp_password }}
SMTP_FROM_ADDRESS={{ mastodon_smtp_from }}
{% if mastodon_smtp_tls == 'tls' %}
SMTP_ENABLE_STARTTLS=never
SMTP_TLS=true
SMTP_SSL=false
{% elif mastodon_smtp_tls == 'starttls' %}
SMTP_ENABLE_STARTTLS=always
SMTP_TLS=false
SMTP_SSL=false
{% else %}
SMTP_ENABLE_STARTTLS=auto
SMTP_TLS=false
SMTP_SSL=false
{% endif %}

# Login only through the local Authelia. The named Authelia policy of the
# client enforces the instance LDAP groups; Mastodon creates the local
# account on the first successful login.
OIDC_ENABLED=true
OIDC_DISPLAY_NAME=Authelia
OIDC_DISCOVERY=true
OIDC_USE_PKCE=true
OIDC_ISSUER={{ mastodon_oidc_issuer }}
OIDC_SCOPE=openid,profile,email
OIDC_UID_FIELD=preferred_username
OIDC_CLIENT_ID=mastodon-{{ mastodon_instance.name }}
OIDC_CLIENT_SECRET={{ lookup('file', mastodon_oidc_secret_file) }}
OIDC_REDIRECT_URI=https://{{ mastodon_instance.domain }}/auth/auth/openid_connect/callback
OIDC_IDP_LOGOUT_REDIRECT_URI={{ mastodon_oidc_issuer }}/logout
OIDC_SECURITY_ASSUME_EMAIL_IS_VERIFIED=true
OMNIAUTH_ONLY=true
ONE_CLICK_SSO_LOGIN=true
ALLOW_UNSAFE_AUTH_PROVIDER_REATTACH=false
