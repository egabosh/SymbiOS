{# SymbiOS - generated by services/mastodon.yml. Do not edit by hand. #}
      mastodon-{{ mastodon_instance.name }}:
        # Group membership is mandatory for every login: no general LAN rule
        # may downgrade this client into an open one-factor login.
        default_policy: deny
        rules:
{% if twofa_enabled | default(false) | bool %}
          # The central no2fa group still works, but only together with an
          # explicit Mastodon group membership.
          - subject:
              - ["group:no2fa", "group:mastodon-{{ mastodon_instance.name }}-users"]
              - ["group:no2fa", "group:mastodon-{{ mastodon_instance.name }}-admins"]
            policy: one_factor
{% endif %}
          - subject:
              - ["group:mastodon-{{ mastodon_instance.name }}-users"]
              - ["group:mastodon-{{ mastodon_instance.name }}-admins"]
            policy: {{ mastodon_auth_policy }}
