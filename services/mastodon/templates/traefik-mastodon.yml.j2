{# SymbiOS - generated by services/mastodon.yml. Do not edit by hand. #}
http:
  routers:
{% for mastodon in mastodon_instances | default([]) %}
    mastodon-{{ mastodon.name }}-streaming:
      rule: "(Host(`{{ mastodon.domain }}`){% for alias in mastodon.aliases | default([]) %} || Host(`{{ alias }}`){% endfor %}) && PathPrefix(`/api/v1/streaming`)"
      priority: 100
      service: mastodon-{{ mastodon.name }}-streaming
      entryPoints:
        - "https"
      tls:
        certResolver: {{ acme_resolver }}
      middlewares:
        - "secHeaders@file"

    mastodon-{{ mastodon.name }}-web:
      rule: "Host(`{{ mastodon.domain }}`){% for alias in mastodon.aliases | default([]) %} || Host(`{{ alias }}`){% endfor %}"
      priority: 10
      service: mastodon-{{ mastodon.name }}-web
      entryPoints:
        - "https"
      tls:
        certResolver: {{ acme_resolver }}
      middlewares:
        - "secHeaders@file"
{% endfor %}

  services:
{% for mastodon in mastodon_instances | default([]) %}
    mastodon-{{ mastodon.name }}-web:
      loadBalancer:
        servers:
          - url: "http://symbios-mastodon-{{ mastodon.name }}-web:3000"

    mastodon-{{ mastodon.name }}-streaming:
      loadBalancer:
        servers:
          - url: "http://symbios-mastodon-{{ mastodon.name }}-streaming:4000"
{% endfor %}
