{# SymbiOS - generated by services/mastodon.yml. Do not edit by hand. #}
name: symbios-mastodon

networks:
  symbios_services:
    external: true
  mastodon-internal:
    driver: bridge
    internal: true

volumes:
{% for mastodon in mastodon_instances | default([]) %}
  mastodon-{{ mastodon.name }}-db:
  mastodon-{{ mastodon.name }}-redis:
  mastodon-{{ mastodon.name }}-public:
{% endfor %}

services:
{% for mastodon in mastodon_instances | default([]) %}

  mastodon-{{ mastodon.name }}-db:
    image: postgres:14-alpine
    container_name: symbios-mastodon-{{ mastodon.name }}-db
    restart: unless-stopped
    shm_size: 256mb
    env_file:
      - ./{{ mastodon.name }}.env.production
    volumes:
      - mastodon-{{ mastodon.name }}-db:/var/lib/postgresql/data
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U mastodon -d mastodon"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - mastodon-internal

  mastodon-{{ mastodon.name }}-redis:
    image: redis:7-alpine
    container_name: symbios-mastodon-{{ mastodon.name }}-redis
    restart: unless-stopped
    command: sh -c 'redis-server --appendonly yes --requirepass "$$REDIS_PASSWORD"'
    env_file:
      - ./{{ mastodon.name }}.env.production
    volumes:
      - mastodon-{{ mastodon.name }}-redis:/data
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD-SHELL", "REDISCLI_AUTH=$$REDIS_PASSWORD redis-cli ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - mastodon-internal

  mastodon-{{ mastodon.name }}-web:
    image: ghcr.io/mastodon/mastodon:{{ mastodon_image_tag }}
    container_name: symbios-mastodon-{{ mastodon.name }}-web
    restart: unless-stopped
    command: bundle exec puma -C config/puma.rb
    env_file:
      - ./{{ mastodon.name }}.env.production
    volumes:
      - mastodon-{{ mastodon.name }}-public:/mastodon/public/system
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      mastodon-{{ mastodon.name }}-db:
        condition: service_healthy
      mastodon-{{ mastodon.name }}-redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -s --noproxy '*' localhost:3000/health | grep -q OK"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - mastodon-internal
      - symbios_services

  mastodon-{{ mastodon.name }}-streaming:
    image: ghcr.io/mastodon/mastodon-streaming:{{ mastodon_image_tag }}
    container_name: symbios-mastodon-{{ mastodon.name }}-streaming
    restart: unless-stopped
    command: node ./streaming/index.js
    env_file:
      - ./{{ mastodon.name }}.env.production
    depends_on:
      mastodon-{{ mastodon.name }}-db:
        condition: service_healthy
      mastodon-{{ mastodon.name }}-redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -s --noproxy '*' localhost:4000/api/v1/streaming/health | grep -q OK"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - mastodon-internal
      - symbios_services

  mastodon-{{ mastodon.name }}-sidekiq:
    image: ghcr.io/mastodon/mastodon:{{ mastodon_image_tag }}
    container_name: symbios-mastodon-{{ mastodon.name }}-sidekiq
    restart: unless-stopped
    command: bundle exec sidekiq
    env_file:
      - ./{{ mastodon.name }}.env.production
    volumes:
      - mastodon-{{ mastodon.name }}-public:/mastodon/public/system
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      mastodon-{{ mastodon.name }}-db:
        condition: service_healthy
      mastodon-{{ mastodon.name }}-redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "ps aux | grep '[s]idekiq' | grep -q ."]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - mastodon-internal

{% endfor %}
