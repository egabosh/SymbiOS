#!/bin/sh
# OpenWrt QEMU VM - WAN + internal network config (first boot only)
#
# eth0 = WAN (static 192.168.41.201/24 on the base-services bridge)
# eth1..eth4 = internal networks. The VM owns the .1 / ::1 gateway on each
# segment; the host bridges (openwrt-lan/-iot/-tor/-misc) are pure L2.
# iot + tor use an internal bridge (br-iot/br-tor, eth2/eth3 as member) so
# the OpenVPN tap devices can be attached to those segments (mirrors the
# linux-setups topology where br-tor/br-iot carry the switch ports).

# Remove default bridge device and LAN interface
while uci delete network.@device[0] 2>/dev/null
do
  :
done
uci delete network.lan 2>/dev/null
uci delete network.wan6 2>/dev/null

# WAN interface on eth0 (static IPv4, IPv6 added below with the host prefix)
uci set network.wan=interface
uci set network.wan.proto=static
uci set network.wan.device=eth0
uci set network.wan.ipaddr={{ vm_ip }}
uci set network.wan.netmask={{ vm_netmask }}
uci set network.wan.gateway={{ vm_gateway }}
uci set network.wan.dns={{ vm_dns }}

# Internal networks - the VM is the .1 gateway on each segment.
{% for net in ow_networks %}
{% if net.bridge_ports is defined and net.bridge_ports %}
# internal bridge for {{ net.uci }} (member: {{ net.bridge_ports }})
uci set network.{{ net.uci }}_dev=device
uci set network.{{ net.uci }}_dev.name={{ net.device }}
uci set network.{{ net.uci }}_dev.type=bridge
uci set network.{{ net.uci }}_dev.ports={{ net.bridge_ports }}
uci set network.{{ net.uci }}_dev.stp=0
{% endif %}
uci set network.{{ net.uci }}=interface
uci set network.{{ net.uci }}.proto=static
uci set network.{{ net.uci }}.device={{ net.device }}
uci set network.{{ net.uci }}.ipaddr={{ net.ip }}
uci set network.{{ net.uci }}.netmask={{ lan_netmask }}
uci set network.{{ net.uci }}.ip6addr={{ net.ip6 }}
{% endfor %}

# IPv6 static address + default route (host-detected GUA prefix)
PREFIX="{{ host_ipv6_prefix | default('') }}"
if [ -n "$PREFIX" ]
then
  uci set network.wan.ip6addr="${PREFIX}::201/64"
  uci set network.wan.ip6gw="${PREFIX}::1"
fi

# Attended sysupgrade: only check for upgrades when logged in
uci set attendedsysupgrade.client.login_check_for_upgrades='1'

uci commit network
uci commit attendedsysupgrade

# Disable DAD for IPv6 stability
cat > /etc/sysctl.d/99-no-dad.conf << SYSCTLEOF
net.ipv6.conf.eth0.accept_dad=0
net.ipv6.conf.all.accept_dad=0
SYSCTLEOF
sysctl -p /etc/sysctl.d/99-no-dad.conf 2>/dev/null || true

exit 0