sed -i 's/127\.0\.0\.55/127.0.0.56/g' /etc/dnscrypt-proxy2/dnscrypt-proxy-max.toml
# The dnscrypt-proxy2 package is installed online (postconfig), so the -max
# init script copy happens there. Offline this is a no-op guard.
[ -x /etc/init.d/dnscrypt-proxy ] && cp -p /etc/init.d/dnscrypt-proxy /etc/init.d/dnscrypt-proxy-max
