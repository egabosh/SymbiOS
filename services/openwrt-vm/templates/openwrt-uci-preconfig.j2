uci add_list dhcp.lan_dnsmasq.listen_address="${LAN6}"
uci add_list dhcp.lan_dnsmasq.listen_address="${MISC4}"
uci add_list dhcp.lan_dnsmasq.listen_address="${MISC6}"
# Run the lan/misc DHCP sockets exclusively on the direct-eth interfaces
# (SO_BINDTODEVICE). Without interface= dnsmasq binds wildcard 0.0.0.0:67
# and the kernel picks only one of the three instances for broadcasts ->
# lan/misc never see DISCOVERs (iot/tor won by luck on their bridges).
uci add_list dhcp.lan_dnsmasq.interface='eth1'
uci add_list dhcp.lan_dnsmasq.interface='eth4'
# Never bind the 127.0.0.1:53 loopback DNS socket: the first of the three
# instances grabs it and the others fail with "Address in use".
uci add_list dhcp.lan_dnsmasq.notinterface='lo'
