#!/bin/sh
# OpenWrt QEMU VM - preconfiguration (uc_set, files, firewall, services)
#
# Runs once at first boot right after 98-openwrt-network. Everything here is
# offline (uci + static files). Network-dependent steps (package install,
# key/cert generation, blocklist + netboot downloads) run from the injected
# /etc/hotplug.d/iface/80-openwrt-postconfig as soon as the WAN is up.
#
# This is the consolidated first-boot equivalent of the linux-setups/openwrt
# playbooks adapted to the VM context:
#   basics, logserver, firewall, firewall_allow_internet,
#   firewall_hijack_connections, dnscrypt-proxy, dhcp, tor, iot,
#   openvpn-tor, openvpn-iot, ssh, smtp (only if inventory SMTP is set),
#   avahi, wireguard-lan, wireguard-tor, netboot
#
# Package management uses apk (OpenWrt 25.x: opkg has been replaced by apk);
# the online postconfig falls back to opkg only on pre-25 images.

# Interface IPs (resolved from the network config committed by the network
# script so the preconfig never duplicates the literals).
LAN4="$(uci get network.lan.ipaddr 2>/dev/null)"
LAN6="$(uci get network.lan.ip6addr 2>/dev/null | cut -d/ -f1)"
IOT4="$(uci get network.iot.ipaddr 2>/dev/null)"
IOT6="$(uci get network.iot.ip6addr 2>/dev/null | cut -d/ -f1)"
TOR4="$(uci get network.tor.ipaddr 2>/dev/null)"
TOR6="$(uci get network.tor.ip6addr 2>/dev/null | cut -d/ -f1)"
MISC4="$(uci get network.misc.ipaddr 2>/dev/null)"
MISC6="$(uci get network.misc.ip6addr 2>/dev/null | cut -d/ -f1)"

# Shared helper directories. /etc/scripts and /etc/openvpn are not part of the
# base image (openvpn package installs later in the postconfig), but several
# heredocs below write into them - create them up front so those writes
# succeed instead of silently failing.
mkdir -p /etc/scripts /etc/openvpn

# Subnets (/24 v4, sd::s/64 v6) derived from the gateway addresses
_g4net() { echo "$1" | cut -d. -f1-3; }
_g6net() { echo "$1" | sed 's#/.*##; s#::1$#::/64#'; }
LANNET4="$(_g4net "$LAN4").0/24"
IOTNET4="$(_g4net "$IOT4").0/24"
TORNET4="$(_g4net "$TOR4").0/24"
MISCNET4="$(_g4net "$MISC4").0/24"
LANNET6="$(_g6net "$LAN6")"
IOTNET6="$(_g6net "$IOT6")"
TORNET6="$(_g6net "$TOR6")"
MISCNET6="$(_g6net "$MISC6")"

# =============================================================
# 1) basics.yml (VM-adapted: no USB stick / fstab mount)
# =============================================================
uci set system.@system[0].timezone='{{ openwrt_timezone }}'
uci set system.@system[0].hostname='{{ openwrt_hostname }}'
uci set system.@system[0].zonename='{{ openwrt_zonename }}'
uci set system.ntp.enable_server='1'
uci set system.ntp.server='{{ openwrt_ntp_servers }}'
uci set irqbalance.irqbalance.enabled='1'
uci set fstab.@global[0].anon_mount='0'
uci set fstab.@global[0].anon_swap='0'
uci set fstab.@global[0].auto_swap='1'
uci set fstab.@global[0].auto_mount='1'
uci set fstab.@global[0].from_fstab='1'

# =============================================================
# 2) logserver.yml (remote syslog to the host gateway)
# =============================================================
uci set system.@system[0].log_ip='{{ openwrt_logserver_ip }}'
uci set system.@system[0].log_proto='udp'
uci set system.@system[0].cronloglevel='5'
uci set system.@system[0].log_size='0'

# =============================================================
# 3) ssh.yml (dropbear: lan only on 22, internet on 44)
# =============================================================
uci set dropbear.main.Port='22'
uci set dropbear.main.Interface='lan'
uci set dropbear.main.PasswordAuth='off'
uci set dropbear.main.RootPasswordAuth='off'
uci set dropbear.global='dropbear'
uci set dropbear.global.Port='44'
uci set dropbear.global.PasswordAuth='off'
uci set dropbear.global.RootPasswordAuth='off'

# =============================================================
# 4) firewall.yml + allowed internet + hijacked connections
#    Firewall is fully rebuilt so all zones/rules live in one place.
# =============================================================
while uci delete firewall.@defaults[0] 2>/dev/null
do
  :
done
for sec in zone forwarding rule redirect include ipset
do
  while uci delete firewall.@${sec}[0] 2>/dev/null
  do
    :
  done
done

# -- defaults (flow offloading off: virtio NIC, avoids flowtable issues)
uci set firewall.defaults='defaults'
uci set firewall.defaults.input='DROP'
uci set firewall.defaults.output='ACCEPT'
uci set firewall.defaults.forward='DROP'
uci set firewall.defaults.synflood_protect='1'
uci set firewall.defaults.drop_invalid='1'
uci set firewall.defaults.flow_offloading='0'

# -- zones: wan (internet), lan (+misc), iot (restricted), tor (isolated)
uci set firewall.zone_wan='zone'
uci set firewall.zone_wan.name='wan'
uci set firewall.zone_wan.network='wan'
uci set firewall.zone_wan.input='ACCEPT'
uci set firewall.zone_wan.output='ACCEPT'
uci set firewall.zone_wan.forward='REJECT'
uci set firewall.zone_wan.masq='1'
uci set firewall.zone_wan.mtu_fix='1'

uci set firewall.zone_lan='zone'
uci set firewall.zone_lan.name='lan'
uci set firewall.zone_lan.network='lan misc'
uci set firewall.zone_lan.input='ACCEPT'
uci set firewall.zone_lan.output='ACCEPT'
uci set firewall.zone_lan.forward='ACCEPT'
uci set firewall.zone_lan.log='1'
uci set firewall.zone_lan.masq='0'
uci set firewall.zone_lan.mtu_fix='0'
# Explicit device list: fw4 may start before eth1/eth4 exist as netifd
# devices; without it the zone misses the direct-eth segments on first boot.
uci add_list firewall.zone_lan.device='eth1'
uci add_list firewall.zone_lan.device='eth4'

uci set firewall.zone_iot='zone'
uci set firewall.zone_iot.name='iot'
uci set firewall.zone_iot.network='iot'
uci set firewall.zone_iot.input='REJECT'
uci set firewall.zone_iot.output='ACCEPT'
uci set firewall.zone_iot.forward='ACCEPT'
uci set firewall.zone_iot.log='1'
uci set firewall.zone_iot.masq='0'
uci set firewall.zone_iot.mtu_fix='0'

uci set firewall.zone_tor='zone'
uci set firewall.zone_tor.name='tor'
uci set firewall.zone_tor.network='tor'
uci set firewall.zone_tor.input='REJECT'
uci set firewall.zone_tor.output='ACCEPT'
uci set firewall.zone_tor.forward='ACCEPT'
uci set firewall.zone_tor.log='1'
uci set firewall.zone_tor.masq='0'
uci set firewall.zone_tor.mtu_fix='0'

# -- forwardings: lan -> wan/internet, lan -> iot, lan -> tor
uci set firewall.wan_forward='forwarding'
uci set firewall.wan_forward.src='lan'
uci set firewall.wan_forward.dest='wan'

uci set firewall.forwarding_lan_iot='forwarding'
uci set firewall.forwarding_lan_iot.src='lan'
uci set firewall.forwarding_lan_iot.dest='iot'

uci set firewall.forwarding_lan_tor='forwarding'
uci set firewall.forwarding_lan_tor.src='lan'
uci set firewall.forwarding_lan_tor.dest='tor'

# -- allow everything from lan to the internet (firewall_allow_internet.yml)
uci set firewall.rule_forward_internet_all='rule'
uci set firewall.rule_forward_internet_all.src='lan'
uci set firewall.rule_forward_internet_all.dest='wan'
uci set firewall.rule_forward_internet_all.target='ACCEPT'
uci set firewall.rule_forward_internet_all.proto='tcp udp'
uci set firewall.rule_forward_internet_all.name='ansible_forward_internet_all'
uci set firewall.rule_forward_internet_all.dest_port='1-65535'

# -- WAN input: ping, ICMPv6, HTTP/HTTPS (Traefik), SSH 44 (ssh.yml)
uci set firewall.rule_allow_ping='rule'
uci set firewall.rule_allow_ping.name='Allow-Ping-WAN'
uci set firewall.rule_allow_ping.src='wan'
uci set firewall.rule_allow_ping.proto='icmp'
uci set firewall.rule_allow_ping.icmp_type='echo-request'
uci set firewall.rule_allow_ping.family='ipv4'
uci set firewall.rule_allow_ping.target='ACCEPT'

uci set firewall.rule_allow_icmpv6='rule'
uci set firewall.rule_allow_icmpv6.name='Allow-ICMPv6-WAN'
uci set firewall.rule_allow_icmpv6.src='wan'
uci set firewall.rule_allow_icmpv6.proto='icmpv6'
uci set firewall.rule_allow_icmpv6.icmp_type="echo-request neighbor-solicitation neighbor-advertisement router-solicitation router-advertisement destination-unreachable packet-too-big time-exceeded"
uci set firewall.rule_allow_icmpv6.family='ipv6'
uci set firewall.rule_allow_icmpv6.target='ACCEPT'

uci set firewall.rule_allow_http='rule'
uci set firewall.rule_allow_http.name='Allow-HTTP-WAN'
uci set firewall.rule_allow_http.src='wan'
uci set firewall.rule_allow_http.proto='tcp'
uci set firewall.rule_allow_http.dest_port='80'
uci set firewall.rule_allow_http.target='ACCEPT'

uci set firewall.rule_allow_https='rule'
uci set firewall.rule_allow_https.name='Allow-HTTPS-WAN'
uci set firewall.rule_allow_https.src='wan'
uci set firewall.rule_allow_https.proto='tcp'
uci set firewall.rule_allow_https.dest_port='443'
uci set firewall.rule_allow_https.target='ACCEPT'

uci set firewall.rule_allow_ssh='rule'
uci set firewall.rule_allow_ssh.name='Allow-SSH-WAN'
uci set firewall.rule_allow_ssh.src='wan'
uci set firewall.rule_allow_ssh.proto='tcp'
uci set firewall.rule_allow_ssh.dest_port='22'
uci set firewall.rule_allow_ssh.target='ACCEPT'

uci set firewall.rule_allow_ssh_global='rule'
uci set firewall.rule_allow_ssh_global.name='ansible_allow_ssh_global'
uci set firewall.rule_allow_ssh_global.src='wan'
uci set firewall.rule_allow_ssh_global.proto='tcp'
uci set firewall.rule_allow_ssh_global.dest_port='44'
uci set firewall.rule_allow_ssh_global.target='ACCEPT'

# -- DNS/NTP hijack redirection (firewall_hijack_connections.yml)
#    empty dest_ip -> redirect to the router itself (the .1 gateways)
uci set firewall.redirect_hijack__dns='redirect'
uci set firewall.redirect_hijack__dns.target='DNAT'
uci set firewall.redirect_hijack__dns.name='ansible_hijack__dns'
uci set firewall.redirect_hijack__dns.src=''
uci set firewall.redirect_hijack__dns.dest='wan'
uci set firewall.redirect_hijack__dns.src_dport='53'
uci set firewall.redirect_hijack__dns.dest_ip=''
uci set firewall.redirect_hijack__dns.dest_port='53'

uci set firewall.redirect_hijack__ntp='redirect'
uci set firewall.redirect_hijack__ntp.target='DNAT'
uci set firewall.redirect_hijack__ntp.name='ansible_hijack__ntp'
uci set firewall.redirect_hijack__ntp.src=''
uci set firewall.redirect_hijack__ntp.dest='wan'
uci set firewall.redirect_hijack__ntp.src_dport='123'
uci set firewall.redirect_hijack__ntp.dest_ip=''
uci set firewall.redirect_hijack__ntp.dest_port='123'

uci set firewall.redirect_hijack_iot_dns='redirect'
uci set firewall.redirect_hijack_iot_dns.target='DNAT'
uci set firewall.redirect_hijack_iot_dns.name='ansible_hijack_iot_dns'
uci set firewall.redirect_hijack_iot_dns.src='iot'
uci set firewall.redirect_hijack_iot_dns.dest='wan'
uci set firewall.redirect_hijack_iot_dns.src_dport='53'
uci set firewall.redirect_hijack_iot_dns.dest_ip="${IOT4}"
uci set firewall.redirect_hijack_iot_dns.dest_port='53'

uci set firewall.redirect_hijack_iot_ntp='redirect'
uci set firewall.redirect_hijack_iot_ntp.target='DNAT'
uci set firewall.redirect_hijack_iot_ntp.name='ansible_hijack_iot_ntp'
uci set firewall.redirect_hijack_iot_ntp.src='iot'
uci set firewall.redirect_hijack_iot_ntp.dest='wan'
uci set firewall.redirect_hijack_iot_ntp.src_dport='123'
uci set firewall.redirect_hijack_iot_ntp.dest_ip="${IOT4}"
uci set firewall.redirect_hijack_iot_ntp.dest_port='123'

uci set firewall.redirect_hijack_tor_dns='redirect'
uci set firewall.redirect_hijack_tor_dns.target='DNAT'
uci set firewall.redirect_hijack_tor_dns.name='ansible_hijack_tor_dns'
uci set firewall.redirect_hijack_tor_dns.src='tor'
uci set firewall.redirect_hijack_tor_dns.dest='wan'
uci set firewall.redirect_hijack_tor_dns.src_dport='53'
uci set firewall.redirect_hijack_tor_dns.dest_ip="${TOR4}"
uci set firewall.redirect_hijack_tor_dns.dest_port='53'

uci set firewall.redirect_hijack_tor_ntp='redirect'
uci set firewall.redirect_hijack_tor_ntp.target='DNAT'
uci set firewall.redirect_hijack_tor_ntp.name='ansible_hijack_tor_ntp'
uci set firewall.redirect_hijack_tor_ntp.src='tor'
uci set firewall.redirect_hijack_tor_ntp.dest='wan'
uci set firewall.redirect_hijack_tor_ntp.src_dport='123'
uci set firewall.redirect_hijack_tor_ntp.dest_ip="${TOR4}"
uci set firewall.redirect_hijack_tor_ntp.dest_port='123'

# =============================================================
# 5) iot.yml (br-iot network, DHCP/DNS, firewall rules)
# =============================================================
# Reset the DHCP/DNS config once *before* building the section set. The
# factory image ships a default dhcp config (lan pool + unnamed dnsmasq
# instance); if this reset ran after iot/tor were defined it would delete
# those sections again (each subsequent §x defines its own dhcp pools and
# dnsmasq instances, the first section here must start from a clean slate).
while uci delete dhcp.@dnsmasq[0] 2>/dev/null
do
  :
done
while uci delete dhcp.@dhcp[0] 2>/dev/null
do
  :
done

uci set network.iot.dns="${IOT4}"
uci set network.iot.ipv6='1'
uci set network.iot.ip6assign='64'

uci set dhcp.iot='dhcp'
uci set dhcp.iot.interface='iot'
uci set dhcp.iot.instance='iot_dnsmasq'
uci set dhcp.iot.start='50'
uci set dhcp.iot.limit='150'
uci set dhcp.iot.leasetime='1h'
uci set dhcp.iot.rebind_protection='0'
uci set dhcp.iot.dhcpv4='server'
uci set dhcp.iot.dhcpv6='server'
uci set dhcp.iot.ra='server'
uci set dhcp.iot.ra_management='1'
uci set dhcp.iot.ra_default='1'
uci set dhcp.iot.ra_lifetime='1800'
uci set dhcp.iot.force='1'
uci -q delete dhcp.iot.dhcp_option
uci add_list dhcp.iot.dhcp_option='119,iot,lan'
uci add_list dhcp.iot.dhcp_option="6,${IOT4}"
uci set dhcp.iot.dns="${IOT6}"

uci set dhcp.iot_dnsmasq='dnsmasq'
uci set dhcp.iot_dnsmasq.domain='iot'
uci set dhcp.iot_dnsmasq.resolvfile='/etc/resolv.dnsmasq.iot'
uci set dhcp.iot_dnsmasq.leasefile='/tmp/dhcp.iot.leases'
uci add_list dhcp.iot_dnsmasq.listen_address="${IOT4}"
uci add_list dhcp.iot_dnsmasq.listen_address="${IOT6}"
uci add_list dhcp.iot_dnsmasq.interface='br-iot'
uci add_list dhcp.iot_dnsmasq.notinterface='lo'
uci set dhcp.iot_dnsmasq.logqueries='1'
uci set dhcp.iot_dnsmasq.logdhcp='1'
uci set dhcp.iot_dnsmasq.authoritative='1'
uci set dhcp.iot_dnsmasq.sequential_ip='1'
uci set dhcp.iot_dnsmasq.server="/.lan/${LAN4}"

# -- iot firewall rules
uci set firewall.rule_allow_dhcp_iot='rule'
uci set firewall.rule_allow_dhcp_iot.name='ansible_Allow-DHCP-iot'
uci set firewall.rule_allow_dhcp_iot.src='iot'
uci set firewall.rule_allow_dhcp_iot.proto='udp'
uci set firewall.rule_allow_dhcp_iot.dest_port='67-68'
uci set firewall.rule_allow_dhcp_iot.target='ACCEPT'

uci set firewall.rule_allow_dns_iot='rule'
uci set firewall.rule_allow_dns_iot.name='ansible_Allow-DNS-iot'
uci set firewall.rule_allow_dns_iot.src='iot'
uci set firewall.rule_allow_dns_iot.proto='udp'
uci set firewall.rule_allow_dns_iot.dest_port='53'
uci set firewall.rule_allow_dns_iot.target='ACCEPT'
uci set firewall.rule_allow_dns_iot.src_ip="${IOTNET4}"
uci set firewall.rule_allow_dns_iot.dest_ip="${IOT4}"

uci set firewall.rule_allow_dns_iot6='rule'
uci set firewall.rule_allow_dns_iot6.name='ansible_allow_dns_iot6'
uci set firewall.rule_allow_dns_iot6.src='iot'
uci set firewall.rule_allow_dns_iot6.proto='udp'
uci set firewall.rule_allow_dns_iot6.dest_port='53'
uci set firewall.rule_allow_dns_iot6.target='ACCEPT'
uci set firewall.rule_allow_dns_iot6.family='ipv6'
uci set firewall.rule_allow_dns_iot6.src_ip="${IOTNET6}"
uci set firewall.rule_allow_dns_iot6.dest_ip="${IOT6}"

uci set firewall.rule_allow_ntp_iot='rule'
uci set firewall.rule_allow_ntp_iot.name='ansible_allow_ntp_iot'
uci set firewall.rule_allow_ntp_iot.src='iot'
uci set firewall.rule_allow_ntp_iot.proto='udp'
uci set firewall.rule_allow_ntp_iot.dest_port='123'
uci set firewall.rule_allow_ntp_iot.target='ACCEPT'
uci set firewall.rule_allow_ntp_iot.src_ip="${IOTNET4}"
uci set firewall.rule_allow_ntp_iot.dest_ip="${IOT4}"

uci set firewall.rule_allow_ntpv6_iot='rule'
uci set firewall.rule_allow_ntpv6_iot.name='ansible_allow_ntpv6_iot'
uci set firewall.rule_allow_ntpv6_iot.src='iot'
uci set firewall.rule_allow_ntpv6_iot.proto='udp'
uci set firewall.rule_allow_ntpv6_iot.dest_port='123'
uci set firewall.rule_allow_ntpv6_iot.src_ip="${IOTNET6}"
uci set firewall.rule_allow_ntpv6_iot.dest_ip="${IOT6}"
uci set firewall.rule_allow_ntpv6_iot.family='ipv6'
uci set firewall.rule_allow_ntpv6_iot.target='ACCEPT'

uci set firewall.rule_allow_icmpv6_nd_iot='rule'
uci set firewall.rule_allow_icmpv6_nd_iot.name='ansible_allow_icmpv6_nd_iot'
uci set firewall.rule_allow_icmpv6_nd_iot.src='iot'
uci set firewall.rule_allow_icmpv6_nd_iot.family='ipv6'
uci set firewall.rule_allow_icmpv6_nd_iot.proto='icmp'
uci set firewall.rule_allow_icmpv6_nd_iot.icmp_type='135 136 133'
uci set firewall.rule_allow_icmpv6_nd_iot.target='ACCEPT'

uci set firewall.rule_allow_icmp_ping_iot='rule'
uci set firewall.rule_allow_icmp_ping_iot.name='ansible_allow_icmp_ping_iot'
uci set firewall.rule_allow_icmp_ping_iot.src='iot'
uci set firewall.rule_allow_icmp_ping_iot.proto='icmp'
uci set firewall.rule_allow_icmp_ping_iot.icmp_type='echo-request'
uci set firewall.rule_allow_icmp_ping_iot.target='ACCEPT'
uci set firewall.rule_allow_icmp_ping_iot.src_ip="${IOTNET4}"
uci set firewall.rule_allow_icmp_ping_iot.dest_ip="${IOT4}"

uci set firewall.rule_allow_icmpv6_ping_iot='rule'
uci set firewall.rule_allow_icmpv6_ping_iot.name='ansible_allow_icmpv6_ping_iot'
uci set firewall.rule_allow_icmpv6_ping_iot.src='iot'
uci set firewall.rule_allow_icmpv6_ping_iot.family='ipv6'
uci set firewall.rule_allow_icmpv6_ping_iot.proto='icmp'
uci set firewall.rule_allow_icmpv6_ping_iot.icmp_type='echo-request'
uci set firewall.rule_allow_icmpv6_ping_iot.target='ACCEPT'
uci set firewall.rule_allow_icmpv6_ping_iot.src_ip="${IOTNET6}"
uci set firewall.rule_allow_icmpv6_ping_iot.dest_ip="${IOT6}"

# =============================================================
# 6) tor.yml (br-tor network, DHCP/DNS, tor, privoxy, routing)
# =============================================================
uci set network.tor.dns='127.0.0.56'
uci set network.tor.ipv6='1'
uci set network.tor.ip6assign='64'

uci set dhcp.tor='dhcp'
uci set dhcp.tor.interface='tor'
uci set dhcp.tor.instance='tor_dnsmasq'
uci set dhcp.tor.start='50'
uci set dhcp.tor.limit='150'
uci set dhcp.tor.leasetime='1h'
uci set dhcp.tor.rebind_protection='0'
uci set dhcp.tor.dhcpv4='server'
uci set dhcp.tor.dhcpv6='server'
uci set dhcp.tor.ra='server'
uci set dhcp.tor.ra_management='1'
uci set dhcp.tor.ra_default='1'
uci set dhcp.tor.ra_lifetime='1800'
uci set dhcp.tor.force='1'
uci -q delete dhcp.tor.dhcp_option
uci add_list dhcp.tor.dhcp_option='119,tor,lan'
uci add_list dhcp.tor.dhcp_option="6,${TOR4}"
uci set dhcp.tor.dns="${TOR6}"

uci set dhcp.tor_dnsmasq='dnsmasq'
uci set dhcp.tor_dnsmasq.domain='tor'
uci set dhcp.tor_dnsmasq.resolvfile='/etc/resolv.dnsmasq.tor'
uci set dhcp.tor_dnsmasq.leasefile='/tmp/dhcp.tor.leases'
uci add_list dhcp.tor_dnsmasq.listen_address="${TOR4}"
uci add_list dhcp.tor_dnsmasq.listen_address="${TOR6}"
uci add_list dhcp.tor_dnsmasq.interface='br-tor'
uci add_list dhcp.tor_dnsmasq.notinterface='lo'
uci set dhcp.tor_dnsmasq.logqueries='1'
uci set dhcp.tor_dnsmasq.logdhcp='1'
uci set dhcp.tor_dnsmasq.authoritative='1'
uci set dhcp.tor_dnsmasq.sequential_ip='1'
uci set dhcp.tor_dnsmasq.server='/.onion/127.0.0.1#9053'
uci set dhcp.tor_dnsmasq.server="/.lan/${LAN4}"

# -- privoxy (filters local HTTP proxy on the tor network)
uci set privoxy.privoxy.listen_address='0.0.0.0:8118'
uci set privoxy.privoxy.forward_socks5t='/ localhost:9050 .'
uci set privoxy.privoxy.permit_access='0.0.0.0/0'

# -- tor firewall rules
uci set firewall.rule_allow_dhcp_tor='rule'
uci set firewall.rule_allow_dhcp_tor.name='ansible_allow_dhcp_tor'
uci set firewall.rule_allow_dhcp_tor.src='tor'
uci set firewall.rule_allow_dhcp_tor.proto='udp'
uci set firewall.rule_allow_dhcp_tor.dest_port='67-68'
uci set firewall.rule_allow_dhcp_tor.target='ACCEPT'

uci set firewall.rule_allow_dns_tor='rule'
uci set firewall.rule_allow_dns_tor.name='ansible_allow_dns_tor'
uci set firewall.rule_allow_dns_tor.src='tor'
uci set firewall.rule_allow_dns_tor.proto='udp'
uci set firewall.rule_allow_dns_tor.dest_port='53'
uci set firewall.rule_allow_dns_tor.target='ACCEPT'
uci set firewall.rule_allow_dns_tor.src_ip="${TORNET4}"
uci set firewall.rule_allow_dns_tor.dest_ip="${TOR4}"

uci set firewall.rule_allow_dns_tor6='rule'
uci set firewall.rule_allow_dns_tor6.name='ansible_allow_dns_tor6'
uci set firewall.rule_allow_dns_tor6.src='tor'
