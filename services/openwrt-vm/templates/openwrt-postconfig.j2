#!/bin/sh
# OpenWrt QEMU VM - minimal online postconfiguration (first boot, WAN up)
#
# Started from /etc/hotplug.d/iface/80-openwrt-postconfig once the WAN
# interface comes up (guard: /etc/openwrt-postconfig.done). Only the minimal
# steps needed to keep the baseline reachable (SSH + LuCI via Traefik) and to
# provide working DHCP/DNS for the host bridges run here.
#
# Service and router configuration beyond that (zones beyond reachability,
# DNSCrypt/Tor, VPNs, logserver, SMTP, netboot, ...) is the responsibility of
# the external-services/openwrt_* playbooks and is NOT handled here.
#
# Idempotent: existing packages are skipped. /etc/openwrt-postconfig.done is
# only written when the package phase succeeded, otherwise the next "wan" ifup
# retries.

DONE="/etc/openwrt-postconfig.done"
RUNNING="/tmp/openwrt-postconfig.running"
[ -f "$DONE" ] && exit 0
[ -f "$RUNNING" ] && exit 0
touch "$RUNNING"
trap 'rm -f "$RUNNING"' EXIT

LOG="/tmp/openwrt-postconfig.log"
exec >>"$LOG" 2>&1
echo "=== openwrt-postconfig start: $(date) ==="

# ---------------------------------------------------------------
# 0) package manager detection (apk on OpenWrt 25.x, opkg fallback)
# ---------------------------------------------------------------
if command -v apk >/dev/null 2>&1
then
  PKGMGR=apk
elif command -v opkg >/dev/null 2>&1
then
  PKGMGR=opkg
else
  echo "ERROR: neither apk nor opkg found"
  exit 1
fi
echo "package manager: $PKGMGR"

pkg_update() {
  if [ "$PKGMGR" = "apk" ]
  then
    apk update
  else
    opkg update
  fi
}

pkg_installed() {
  if [ "$PKGMGR" = "apk" ]
  then
    apk list -I "$1" 2>/dev/null | grep -q "^${1}-"
  else
    opkg list-installed 2>/dev/null | grep -q "^${1} "
  fi
}

pkg_install() {
  if [ "$PKGMGR" = "apk" ]
  then
    apk add --no-interactive "$1"
  else
    opkg install "$1"
  fi
}

# ---------------------------------------------------------------
# 1) bootstrap DNS + package install (minimal baseline only)
# ---------------------------------------------------------------
rm -f /etc/resolv.conf.stash
cat /etc/resolv.conf > /etc/resolv.conf.stash
cat > /etc/resolv.conf << EOF
nameserver {{ vm_dns }}
EOF

echo "--- refreshing package index"
pkg_update || echo "WARN: package index refresh failed (continuing)"

# Minimal tool baseline. dnsmasq + odhcpd are included as a guard in case the
# image does not ship them; failures are logged and retried on the next ifup.
PKGS="{{ openwrt_packages | join(' ') }}"

PACKAGES_OK=1
for p in $PKGS
do
  [ -z "$p" ] && continue
  if pkg_installed "$p"
  then
    echo "installed: $p"
    continue
  fi
  ok=0
  for attempt in 1 2 3
  do
    if pkg_install "$p"
    then
      ok=1
      echo "ok: $p (attempt $attempt)"
      break
    fi
    echo "attempt $attempt failed: $p"
    sleep 5
  done
  if [ "$ok" = "0" ]
  then
    PACKAGES_OK=0
    echo "GIVING UP: $p"
    echo "$p" >> /var/log/openwrt-package-errors.log
  fi
done

# restore the local resolver (real file on stock layouts, but this works even
# if /etc/resolv.conf is a symlink to /tmp/resolv.conf - never use mv here)
cat /etc/resolv.conf.stash > /etc/resolv.conf
rm -f /etc/resolv.conf.stash

# ---------------------------------------------------------------
# 2) enable + restart baseline services
# ---------------------------------------------------------------
for s in dnsmasq odhcpd
do
  if [ -x "/etc/init.d/$s" ]
  then
    /etc/init.d/$s enable 2>/dev/null
    /etc/init.d/$s restart >/dev/null 2>&1 || true
    echo "service restarted: $s"
  else
    echo "service missing (no init script): $s"
  fi
done
/etc/init.d/network reload >/dev/null 2>&1 || true
/etc/init.d/firewall reload >/dev/null 2>&1 || true

# ---------------------------------------------------------------
# done
# ---------------------------------------------------------------
if [ "$PACKAGES_OK" = "1" ]
then
  touch "$DONE"
  echo "=== openwrt-postconfig completed: $(date) ==="
else
  echo "=== openwrt-postconfig COMPLETED WITH PACKAGE ERRORS (retry on next wan ifup) ==="
  echo "see /var/log/openwrt-package-errors.log"
fi

exit 0
