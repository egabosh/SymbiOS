#!/bin/bash

# matrix-device-health.sh - E2EE device health watchdog for the notify store.
#
# nio marks a member device as "deleted" when it is missing from the
# homeserver's device-key response during sync. Deleted devices are excluded
# from megolm key sharing, so that user can no longer decrypt new messages.
#
# This script checks every deleted device in the sender store against the
# homeserver (POST /keys/query, any authenticated user may query) and unmarks
# devices that still exist on the server. Works against any homeserver via
# the sender access token (no local synapse database needed). After changes
# the matrix-notify daemon is restarted so the store is reloaded.
#
# Run via cron (see base-services/matrix-client.yml) or manually:
#   /usr/local/sbin/matrix-device-health.sh

. /etc/bash/gaboshlib.include

g_lockfile

MATRIX_CLIENT_DIR="{{ base_services_root }}/matrix-client"
HOMESERVER="{{ matrix_homeserver }}"

cd "${MATRIX_CLIENT_DIR}" || exit 1

# Read the sender access token (0600, written by matrix-client.yml).
function f_get_token {
  if [[ -s "${MATRIX_CLIENT_DIR}/.sender_token" ]]
  then
    cat "${MATRIX_CLIENT_DIR}/.sender_token"
    return 0
  fi
  g_echo_error "No sender token - run base-services/matrix-client.yml first"
  return 1
}

# list deleted devices of a store: one "user_id device_id" per line
store_deleted_devices() {
  python3 -c '
import sqlite3, sys
con = sqlite3.connect(sys.argv[1])
for user_id, device_id in con.execute(
    "SELECT user_id, device_id FROM devicekeys WHERE deleted = 1"
):
    print(user_id, device_id)
' "$1" 2>/dev/null
}

# current (live) device ids of a user according to the homeserver
server_live_devices() {
  curl -s --max-time 30 "${HOMESERVER}/_matrix/client/v3/keys/query" -X POST \
    --header "Authorization: Bearer ${TOKEN}" \
    --header 'Content-Type: application/json' \
    --data "{\"device_keys\":{\"$1\":[]}}" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
keys = data.get("device_keys", {}).get(sys.argv[1], {})
print(" ".join(sorted(keys.keys())))
' "$1" 2>/dev/null
}

# unmark one device in one store
unmark_device() {
  python3 -c '
import sqlite3, sys
con = sqlite3.connect(sys.argv[1])
con.execute(
    "UPDATE devicekeys SET deleted = 0 WHERE user_id = ? AND device_id = ?",
    (sys.argv[2], sys.argv[3]),
)
con.commit()
' "$1" "$2" "$3" 2>/dev/null
}

TOKEN="$(f_get_token)" || exit 1

CHANGED_COUNT=0

g_echo_note "Checking deleted devices in ${MATRIX_CLIENT_DIR}"

for STORE_DB in ${MATRIX_CLIENT_DIR}/matrix-commander-data-notify/store/@*.db
do
  [ -f "${STORE_DB}" ] || continue

  DELETED_DEVICES=$(store_deleted_devices "${STORE_DB}")
  if [ -z "${DELETED_DEVICES}" ]; then
    continue
  fi

  # collect unique users with deleted devices in this store
  USERS=$(printf '%s\n' "${DELETED_DEVICES}" | cut -d' ' -f1 | sort -u)

  # build "user device" set of devices that are alive on the server
  LIVE_DEVICES=""
  for USER in ${USERS}
  do
    for DEVICE in $(server_live_devices "${USER}")
    do
      LIVE_DEVICES="${LIVE_DEVICES}${USER} ${DEVICE}
"
    done
  done

  while read -r USER DEVICE
  do
    [ -n "${USER}" ] || continue
    if printf '%s' "${LIVE_DEVICES}" | grep -Fqx "${USER} ${DEVICE}"; then
      unmark_device "${STORE_DB}" "${USER}" "${DEVICE}"
      CHANGED_COUNT=$((CHANGED_COUNT + 1))
      g_echo_warn "Unmarked deleted device ${DEVICE} of ${USER} in notify store"
    else
      g_echo_debug "Device ${DEVICE} of ${USER} is gone on the server - keeping it marked as deleted"
    fi
  done <<< "${DELETED_DEVICES}"
done

if [ "${CHANGED_COUNT}" -gt 0 ]; then
  g_echo "Fixed ${CHANGED_COUNT} device(s), restarting matrix-notify daemon"
  docker compose -p matrix-notify -f ./docker-compose.yml restart matrix-notify >/dev/null 2>&1
  echo "Matrix: unmarked ${CHANGED_COUNT} stale deleted device(s) in notify store" | notify.sh -s "Matrix: device-health fix"
else
  g_echo_ok "No stale deleted devices found"
fi
