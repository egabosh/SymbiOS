---
http:
  routers:
    authelia:
      rule: "Host(`{{ authelia_domain }}`)"
      entryPoints:
        - https
      middlewares:
        - secHeaders@file
      service: authelia
      tls:
        certResolver: "{{ acme_resolver }}"
    symbios-ui:
      rule: "Host(`{{ base_domain }}`)"
      entryPoints:
        - https
      middlewares:
        - secHeaders@file
        - authelia@file
      service: symbios-ui
      tls:
        certResolver: "{{ acme_resolver }}"
    traefik-dashboard:
      rule: "Host(`{{ traefik_domain }}`)"
      entryPoints:
        - https
      middlewares:
        - secHeaders@file
        - authelia@file
      service: api@internal
      tls:
        certResolver: "{{ acme_resolver }}"
  services:
    authelia:
      loadBalancer:
        servers:
          - url: "http://authelia:9091"
    symbios-ui:
      loadBalancer:
        servers:
          - url: "http://symbios-ui:8080"
